        # ------------------------------------------------------------------
        # [07/15] proxychains4 + SOCKS5h 远端 DNS (ATYP=0x03) 协议字节级实测
        # ------------------------------------------------------------------
        socks_seen = {"atyp": None, "domain": "", "ver": None}

        def _socks5_inspector(srv_sock):
            try:
                conn, _ = srv_sock.accept()
                conn.settimeout(3)
                greet = conn.recv(64)
                if greet:
                    socks_seen["ver"] = greet[0]
                    conn.sendall(b"\x05\x00")
                    req = conn.recv(256)
                    if len(req) >= 5:
                        socks_seen["atyp"] = req[3]
                        if req[3] == 3:
                            dlen = req[4]
                            socks_seen["domain"] = req[5 : 5 + dlen].decode("utf-8", "ignore")
                        conn.sendall(b"\x05\x00\x00\x01\x7f\x00\x00\x01\x00\x50")
                        conn.recv(512)
                        conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK")
                conn.close()
            except Exception:
                pass

        s_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s_sock.bind(("127.0.0.1", 0))
        s_sock.listen(2)
        s_port = s_sock.getsockname()[1]
        t_socks = threading.Thread(target=_socks5_inspector, args=(s_sock,), daemon=True)
        t_socks.start()

        clean_net_env = {k: v for k, v in os.environ.items() if not k.upper().endswith("_PROXY")}
        if IS_WINDOWS:
            subprocess.run(
                [CURL_BIN, "--ssl-no-revoke", "-s", "--noproxy", "", "-x", f"socks5h://127.0.0.1:{s_port}", "--max-time", "3", "http://canary-dns-audit.anthropic.invalid/ping"],
                env=clean_net_env,
                capture_output=True,
                timeout=6,
            )
            t_socks.join(timeout=2)
            s_sock.close()
            closed_res = subprocess.run(
                [CURL_BIN, "--ssl-no-revoke", "-s", "--noproxy", "", "-x", f"socks5h://127.0.0.1:{s_port}", "--max-time", "2", "http://198.51.100.1/"],
                env=clean_net_env,
                capture_output=True,
                timeout=5,
            )
        else:
            test_pc_conf = os.path.join(sb, "test_pc.conf")
            with open(test_pc_conf, "w", encoding="utf-8") as f:
                f.write(
                    "strict_chain\nproxy_dns\nremote_dns_subnet 224\ntcp_read_time_out 4000\ntcp_connect_time_out 3000\n"
                    f"localnet 127.0.0.0/255.0.0.0\n[ProxyList]\nsocks5 127.0.0.1 {s_port}\n"
                )
            subprocess.run(
                [pc_bin, "-q", "-f", test_pc_conf, "curl", "-s", "--noproxy", "", "--max-time", "3", "http://canary-dns-audit.anthropic.invalid/ping"],
                env=clean_net_env,
                capture_output=True,
                timeout=6,
            )
            t_socks.join(timeout=2)
            s_sock.close()
            closed_res = subprocess.run(
                [pc_bin, "-q", "-f", test_pc_conf, "curl", "-s", "--noproxy", "", "--max-time", "2", "http://198.51.100.1/"],
                env=clean_net_env,
                capture_output=True,
                timeout=5,
            )
