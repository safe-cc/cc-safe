        tun_ens = subprocess.run(_py_cmd(sb_tun, "ensure"), env=sb_env_base, capture_output=True, timeout=8)

        pid_file_p = os.path.join(acc_cfg_dir, "us-tunnel.pid")
        gost_json_p = os.path.join(acc_cfg_dir, "gost.json")
        g_cmd = ""
        if not IS_WINDOWS and os.path.isfile(pid_file_p):
            try:
                gpid = int(open(pid_file_p).read().strip())
                g_cmd = open(f"/proc/{gpid}/cmdline", "rb").read().decode("utf-8", "ignore")
            except Exception:
                g_cmd = ""
        gost_existed_live = os.path.isfile(gost_json_p)
        gost_cfg_obj = json.load(open(gost_json_p, encoding="utf-8")) if gost_existed_live else {}
        gost_mode = stat.S_IMODE(os.stat(gost_json_p).st_mode) if gost_existed_live else -1
        hop0_has_bypass = any("bypass" in h for c in (gost_cfg_obj.get("chains") or []) for h in (c.get("hops") or []))
        subprocess.run(_py_cmd(sb_tun, "stop"), env=sb_env_base, capture_output=True, timeout=6)
        gost_wiped_on_stop = not os.path.exists(gost_json_p)

        host_cmd_leak = False
        if not IS_WINDOWS:
            for pdir in glob.glob("/proc/[0-9]*"):
                base = os.path.basename(pdir)
                if not base.isdigit():
                    continue
                try:
                    if os.stat(pdir).st_uid != os.getuid():
                        continue
                    c = open(f"{pdir}/cmdline", "rb").read().decode("utf-8", "ignore")
                    if ("gost" in c and "-F\x00" in c) or "sk-ant-oat" in c:
                        host_cmd_leak = True
                except Exception:
                    pass

        ok10 = (
