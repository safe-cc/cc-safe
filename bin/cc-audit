        )

        # ------------------------------------------------------------------
        # [10/15] Gost 零明文命令行、无环回 SSRF 穿透与停机擦除 gost.json 审计
        # ------------------------------------------------------------------
        canary_secret = "Canary$ProxySecret@98765"
        with socket.socket() as s1, socket.socket() as s2:
            s1.bind(("127.0.0.1", 0))
            p_http = s1.getsockname()[1]
            s2.bind(("127.0.0.1", 0))
            p_socks = s2.getsockname()[1]

        json.dump(
            {
                "active_account": "acc_alpha",
