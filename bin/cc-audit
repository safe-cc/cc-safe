        )
        record(
            7,
            "SOCKS5h 远端 DNS (ATYP=0x03) 防泄漏与断链 Fail-Close 阻断实测",
            ok7,
            f"SOCKS5 握手成功，域名以 ATYP=0x03 远端解析 ({socks_seen['domain']}) 无本地 UDP:53 泄漏，断链后 100% 阻断",
        )

        # ------------------------------------------------------------------
        # [08/15] Bun + Node 双栈 IPv6 阻断与大小写代理变量全锁核验
        # ------------------------------------------------------------------
        st_alpha_env = json.load(open(os.path.join(fake_safe_root, "profiles", "acc_alpha", "home", "settings.json"), encoding="utf-8"))["env"]
        launcher_has_vars = (
            ('"all_proxy": proxy_socks_url' in safe_txt and '"https_proxy": proxy_http_url' in safe_txt)
            if IS_WINDOWS
            else ('all_proxy="socks5h://127.0.0.1:7891"' in safe_txt and 'https_proxy="http://127.0.0.1:7890"' in safe_txt)
        )
        ok8 = (
            st_alpha_env.get("BUN_FEATURE_FLAG_DISABLE_IPV6") == "1"
            and st_alpha_env.get("NODE_OPTIONS") == "--dns-result-order=ipv4first"
            and st_alpha_env.get("ALL_PROXY") == "socks5h://127.0.0.1:7891"
            and st_alpha_env.get("all_proxy") == "socks5h://127.0.0.1:7891"
            and st_alpha_env.get("https_proxy") == "http://127.0.0.1:7890"
            and launcher_has_vars
        )
        record(
            8,
            "Bun/Node 双栈 IPv6 阻断与大小写 https_proxy/socks5h 全锁核验",
            ok8,
            "已同时锁定 BUN_FEATURE_FLAG_DISABLE_IPV6=1、ipv4first、大小写 https_proxy 与 socks5h:// 远端解析",
        )

        # ------------------------------------------------------------------
        # [09/15] cc-safe 启动器多重异常场景 Fail-Close 熔断矩阵 (含 NO_PROXY=* 毒化与损坏 JSON)
        # ------------------------------------------------------------------
        breach_flag = os.path.join(sb, "BREACHED")
        if IS_WINDOWS:
            guard_claude = os.path.join(sb, "guard_claude.cmd")
            with open(guard_claude, "w", encoding="utf-8") as f:
                f.write(f'@echo off\r\necho 1 > "{breach_flag}"\r\nexit /b 0\r\n')
            safe_invoke = [sys.executable, sb_win_launcher, "safe"]
        else:
            guard_claude = os.path.join(sb, "guard_claude")
            with open(guard_claude, "w", encoding="utf-8") as f:
                f.write(f"#!/usr/bin/env bash\ntouch '{breach_flag}'\nexit 0\n")
            os.chmod(guard_claude, 0o755)
            safe_invoke = [sb_safe]
        fc_env = dict(sb_env_base, CLAUDE_BIN=guard_claude)

        # A: banned 状态
        accounts_obj["accounts"]["acc_alpha"]["status"] = "banned"
        json.dump(accounts_obj, open(acc_json_p, "w", encoding="utf-8"))
        r_ban = subprocess.run(safe_invoke, env=fc_env, capture_output=True, text=True, timeout=10)

        # B: 缺失 EXPECTED_IP
        accounts_obj["accounts"]["acc_alpha"]["status"] = "active"
        accounts_obj["accounts"]["acc_alpha"]["ip"] = ""
        json.dump(accounts_obj, open(acc_json_p, "w", encoding="utf-8"))
        r_noip = subprocess.run(safe_invoke, env=fc_env, capture_output=True, text=True, timeout=10)

        # C: 损坏的 accounts.json
        open(acc_json_p, "w", encoding="utf-8").write("{broken json!!!")
        r_corrupt = subprocess.run(safe_invoke, env=fc_env, capture_output=True, text=True, timeout=10)

        # D: 调用方环境注入 NO_PROXY=* / no_proxy=* 企图绕过代理校验，且 EXPECTED_IP 不匹配
        accounts_obj["accounts"]["acc_alpha"]["ip"] = "203.0.113.254"
        json.dump(accounts_obj, open(acc_json_p, "w", encoding="utf-8"))
        poison_np_env = dict(fc_env, NO_PROXY="*", no_proxy="*", https_proxy="http://127.0.0.1:9")
        r_mismatch = subprocess.run(safe_invoke, env=poison_np_env, capture_output=True, text=True, timeout=18)

        # 恢复正常 IP
        accounts_obj["accounts"]["acc_alpha"]["ip"] = "198.51.100.11"
        json.dump(accounts_obj, open(acc_json_p, "w", encoding="utf-8"))

        ok9 = (
            r_ban.returncode != 0
            and r_noip.returncode != 0
            and r_corrupt.returncode != 0
            and r_mismatch.returncode != 0
            and not os.path.exists(breach_flag)
