        # ------------------------------------------------------------------
        # [14/15] curl -K 注入拦截、IPv6/特殊字符代理解析与 0700/0600 权限审计 (QA-03/11/12)
        # ------------------------------------------------------------------
        chk_mod = _load_py_module("cc_chk_audit", os.path.join(fake_home, ".local", "bin", "cc-check-ip"))
        tun_mod = _load_py_module("cc_tun_audit", sb_tun)

        inj_blocked = False
        try:
            chk_mod._curl_esc_strict("http://127.0.0.1:8080\noutput = /tmp/pwn")
        except ValueError:
            inj_blocked = True

        inj_tun_blocked = False
        try:
            tun_mod._curl_esc_strict("http://127.0.0.1:8080\r\nurl = http://evil")
        except ValueError:
            inj_tun_blocked = True

        p_url, p_disp = chk_mod.parse_any_proxy("[2001:db8::1]:1080:user@corp:p#ss[1]")
        up_parsed = tun_mod._parse_upstream_url(p_url)
        redacted_s = tun_mod.redact_proxy(p_url)
        ipv6_parse_ok = (
            up_parsed["addr"] == "[2001:db8::1]:1080"
            and up_parsed["username"] == "user@corp"
            and up_parsed["password"] == "p#ss[1]"
            and "user" not in redacted_s
            and "p#ss" not in redacted_s
        )

        if IS_WINDOWS:
            dir_modes_ok = os.path.isdir(fake_safe_root) and os.path.isdir(acc_cfg_dir)
            file_modes_ok = all(
                os.path.isfile(fp)
                for fp in (
                    acc_json_p,
                    alpha_id_p,
                    beta_id_p,
                    os.path.join(fake_safe_root, "profiles", "acc_beta", "home", ".credentials.json"),
                )
            )
        else:
            dir_modes_ok = (
                stat.S_IMODE(os.stat(fake_safe_root).st_mode) == 0o700
                and stat.S_IMODE(os.stat(acc_cfg_dir).st_mode) == 0o700
            )
            file_modes_ok = all(
                stat.S_IMODE(os.stat(fp).st_mode) == 0o600
                for fp in (
                    acc_json_p,
                    alpha_id_p,
                    beta_id_p,
                    os.path.join(fake_safe_root, "profiles", "acc_beta", "home", ".credentials.json"),
                )
            )
        ok14 = inj_blocked and inj_tun_blocked and ipv6_parse_ok and dir_modes_ok and file_modes_ok
        record(
            14,
