            bystander_proc = subprocess.Popen(
                ["sleep", "30"],
                env=dict(os.environ, HOME=fake_home, HTTPS_PROXY="http://127.0.0.1:7890"),
            )
            # 3) 验证 PR_SET_CHILD_SUBREAPER 对 `setsid + env -i` 双重脱离孤儿进程的内核级收养与收割 (QA-07)
            orphan_pid_file = os.path.join(sb, "orphan.pid")
            subreaper_test_code = f"""
import ctypes, glob, os, signal, subprocess, time
libc = ctypes.CDLL("libc.so.6", use_errno=True)
libc.prctl(36, 1, 0, 0, 0)
p = subprocess.Popen(["bash", "-c", "setsid env -i bash -c 'echo $$ > {orphan_pid_file}; exec sleep 30' </dev/null >/dev/null 2>&1 &"])
p.wait()
time.sleep(0.25)
my_pid = os.getpid()
for pdir in glob.glob("/proc/[0-9]*"):
    b = os.path.basename(pdir)
    if b.isdigit() and int(b) != my_pid:
        try:
            st = open(pdir + "/stat", "rb").read().decode("utf-8", "ignore")
            ppid = int(st[st.rfind(")") + 2:].split()[1])
            if ppid == my_pid:
                os.kill(int(b), signal.SIGKILL)
        except Exception:
            pass
"""
            subprocess.run([sys.executable, "-c", subreaper_test_code], timeout=6, check=True)
            orphan_reaped = False
            if os.path.isfile(orphan_pid_file):
                opid = int(open(orphan_pid_file).read().strip())
                time.sleep(0.1)
                orphan_reaped = not os.path.exists(f"/proc/{opid}")

        time.sleep(0.25)
        kill_out = subprocess.run(_py_cmd(sb_sw, "kill-local"), env=sb_env_base, capture_output=True, text=True, timeout=10)
        time.sleep(0.15)
        cc_dead = cc_tree_proc.poll() is not None
        relay_alive = relay_proc.poll() is None
        bystander_alive = bystander_proc.poll() is None
        for bp in (relay_proc, bystander_proc):
            bp.terminate()
            try:
                bp.wait(timeout=2)
            except Exception:
                bp.kill()

        ok11 = cc_dead and orphan_reaped and relay_alive and bystander_alive and kill_out.returncode == 0
        record(
