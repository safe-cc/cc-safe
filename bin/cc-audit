def main():
    args = sys.argv[1:]
    if "--repo-only" in args:
        idx = args.index("--repo-only")
        rdir = args[idx + 1] if idx + 1 < len(args) and not args[idx + 1].startswith("-") else (find_repo_dir() or os.getcwd())
        ok, msg = audit_repo_privacy(rdir)
        if ok:
            print(f"✅ [Repo Privacy Check] {msg}")
            sys.exit(0)
        else:
            print(f"❌ [Repo Privacy Check 阻断] 检测到本机隐私或密钥残留: {msg}", file=sys.stderr)
            sys.exit(1)

    sys.exit(run_full_audit(find_repo_dir()))


if __name__ == "__main__":
    main()
