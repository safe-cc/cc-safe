            wl_mod_w._assign_pid_to_job(hj, job_child.pid)
            wl_mod_w._close_job(hj)
            time.sleep(0.25)
            orphan_reaped = job_child.poll() is not None
            if not orphan_reaped:
                job_child.kill()
        else:
            # 1) 即使父终端残留 ANTHROPIC_BASE_URL，只要带 CC_SAFE_MANAGED=1 仍必须被精准识别清场 (CRITICAL-2.1)
            cc_tree_proc = subprocess.Popen(
                [sys.executable, "-c", "import subprocess, time; c=subprocess.Popen(['sleep','30']); time.sleep(30)"],
                env=dict(
                    sb_env_base,
                    CC_SAFE_MANAGED="1",
                    CC_SAFE_ACCOUNT="acc_alpha",
                    CC_SAFE_ROOT=fake_safe_root,
                    ANTHROPIC_BASE_URL="https://relay-inherited.example.com",
                ),
            )
            # 2) 真实中转会话与普通 :7890 旁路进程绝不可被误杀
            relay_proc = subprocess.Popen(
                ["sleep", "30"],
                env=dict(os.environ, HOME=fake_home, CLAUDE_SUB2API_MANAGED="1", ANTHROPIC_BASE_URL="https://relay.example.com"),
