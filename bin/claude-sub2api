#!/usr/bin/env bash
# claude-sub2api: 纯 API 中转 (Relay) 隔离启动器 — 强制锁定 ~/.claude 并剥离一切个人代理/OAuth 环境
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export CLAUDE_CONFIG_DIR="$HOME/.claude"
export CLAUDE_SUB2API_MANAGED="1"

unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
      HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY \
      http_proxy https_proxy all_proxy no_proxy \
      LD_PRELOAD CC_SAFE_MANAGED CC_SAFE_ACCOUNT

SETTINGS_FILE="$HOME/.claude/sub2api.settings.json"
if [ ! -f "$SETTINGS_FILE" ] || grep -q "sk-REPLACE_WITH_YOUR_RELAY_KEY" "$SETTINGS_FILE" 2>/dev/null; then
    echo "❌ [claude-sub2api] 未完成中转配置: $SETTINGS_FILE" >&2
    echo "   请填入真实 ANTHROPIC_BASE_URL 与 ANTHROPIC_AUTH_TOKEN 后重试。" >&2
    exit 1
fi

CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude || true)}"
if [ -z "$CLAUDE_BIN" ]; then
    echo "❌ [claude-sub2api] 未找到 claude 可执行文件，请先运行 install.sh 安装。" >&2
    exit 1
fi

exec "$CLAUDE_BIN" --settings "$SETTINGS_FILE" "$@"
