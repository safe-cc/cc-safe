#!/usr/bin/env python3
"""
cc-switch: Claude Code (cc-safe) 多账号物理硬隔离、一键换 IP 与独立美国家宽隧道管理器
核心架构:
  1. 账号级物理目录硬隔离: 每账号独占 CLAUDE_CONFIG_DIR = ~/.claude-safe/profiles/<acc>/home，
     零跨号文件覆盖、零软链接共享，与 claude-sub2api 使用的 ~/.claude 100% 物理分家。
  2. 零进程参数/临时权限泄密: 全程 umask 077 + O_CREAT 0600 原子写入；curl 走 `--noproxy "" -K -` 标准输入；Gost 走 0600 JSON。
  3. 切号/换 IP 前双机精准进程树清场: 结合 CC_SAFE_MANAGED / PR_SET_CHILD_SUBREAPER + 叶子优先信号与 (PID, starttime) 追踪，100% 防越狱且零误伤。
  4. 无损换 IP (`cc-switch set-ip`): 自动完成新代理 5 维体检、历史废弃 IP 防复用、双机清场、时区自动对齐，100% 保留原设备指纹与登录态免重登。
  5. 6 维独立设备指纹 + 纯净 Git 身份垫片 + 大小写全套代理与遥测/热更新锁死。
  6. 全链路双通道 (HTTP 7890 + SOCKS5h 7891) IP & US 属地 Fail-Close 强校验 & 封禁状态双机同步锁死 (防 cron 复活)。
"""
import base64
import getpass
import glob
import hashlib
import hmac
import ipaddress
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import socket
import struct
import subprocess
import sys
import time
import uuid
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
from urllib.parse import quote, unquote

IS_WINDOWS = os.name == "nt"
if IS_WINDOWS:
    import ctypes
    from ctypes import wintypes
    import msvcrt
else:
    import fcntl

try:
    os.umask(0o077)
except Exception:
    pass

SELF_DIR = os.path.dirname(os.path.abspath(__file__))
HOME = os.path.expanduser("~")
if IS_WINDOWS:
    os.environ["PATH"] = os.path.join(HOME, ".local", "bin") + os.pathsep + os.environ.get("PATH", "")
    _sys_curl = os.path.join(os.environ.get("SystemRoot") or r"C:\Windows", "System32", "curl.exe")
    CURL_BIN = _sys_curl if os.path.isfile(_sys_curl) else (shutil.which("curl.exe") or "curl")
else:
    os.environ["PATH"] = f"{HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin:" + os.environ.get("PATH", "")
    CURL_BIN = "curl"

SAFE_DIR = os.path.abspath(os.environ.get("CC_SAFE_ROOT") or os.path.join(HOME, ".claude-safe"))
CFG_DIR = os.path.join(SAFE_DIR, "config")
LOCK_DIR = os.path.join(SAFE_DIR, "locks")
PROFILES_DIR = os.path.join(SAFE_DIR, "profiles")

ACCOUNTS_FILE = os.path.join(CFG_DIR, "accounts.json")
TUNNEL_JSON = os.path.join(CFG_DIR, "us-tunnel.json")
TUNNEL_ENV = os.path.join(CFG_DIR, "us-tunnel.env")
LOCK_FILE = os.path.join(LOCK_DIR, "cc.lock")

BIN_DIR = os.path.join(HOME, ".local", "bin")


def _resolve_tool(name: str) -> str:
    py_libexec_cand = os.path.join(SAFE_DIR, "libexec", "py", name)
    if IS_WINDOWS and os.path.isfile(py_libexec_cand):
        return py_libexec_cand
    local_cand = os.path.join(BIN_DIR, name)
    if os.path.isfile(local_cand) and (IS_WINDOWS or os.access(local_cand, os.X_OK)):
        return local_cand
    sib_cand = os.path.join(SELF_DIR, name)
    if os.path.isfile(sib_cand) and (IS_WINDOWS or os.access(sib_cand, os.X_OK)):
        return sib_cand
    return py_libexec_cand if IS_WINDOWS else local_cand


def _py_cmd(script_path: str, *args: str) -> list:
    if IS_WINDOWS:
        return [sys.executable, script_path, *args]
    return [script_path, *args]


CC_SAFE = _resolve_tool("cc-safe")
CC_TOTP = _resolve_tool("cc-totp")
CC_TUNNEL = _resolve_tool("cc-us-tunnel")
CC_CHECK_IP = _resolve_tool("cc-check-ip")
CC_AUDIT = _resolve_tool("cc-audit")

HOSTNAME = socket.gethostname()
PROXY_HTTP = "http://127.0.0.1:7890"
PROXY_SOCKS = "socks5h://127.0.0.1:7891"


def get_tunnel_proxy_urls() -> tuple:
    http_l = "127.0.0.1:7890"
    socks_l = "127.0.0.1:7891"
    if os.path.isfile(TUNNEL_JSON):
        try:
            with open(TUNNEL_JSON, "r", encoding="utf-8") as f:
                tj = json.load(f)
            if isinstance(tj, dict):
                http_l = str(tj.get("http_listen") or http_l).strip()
                socks_l = str(tj.get("socks_listen") or socks_l).strip()
        except Exception:
            pass
    return f"http://{http_l}", f"socks5h://{socks_l}", http_l, socks_l


ALIAS_RE = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9_-]{0,31}$")
PEER_HOST_RE = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$")
UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
SSH_BASE_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=accept-new"]

RESERVED_VERBS = {
    "status", "list", "ls", "init", "quickstart", "wizard",
    "add", "set-ip", "change-ip", "rotate-ip", "update-ip", "set-proxy", "update-proxy", "huan-ip",
    "rm", "remove", "del", "delete",
    "kill", "kill-local", "clean-procs",
    "usage", "quota", "reset", "limit-reset",
    "doctor", "audit", "test-leak", "totp", "pass", "check-ip",
    "ban", "unban", "set-peer", "win-proxy", "import-session", "desktop", "chrome",
    "apply-local", "auto-sync", "sync", "sync-cred",
    "help", "-h", "--help", "version", "-v", "--version",
}


def ensure_dir_700(path: str):
    os.makedirs(path, mode=0o700, exist_ok=True)
    try:
        os.chmod(path, 0o700)
    except OSError:
        pass


def ensure_base_dirs():
    for _d in (SAFE_DIR, CFG_DIR, LOCK_DIR, PROFILES_DIR):
        ensure_dir_700(_d)


_CACHED_CLAUDE_VER = None


def get_claude_version() -> str:
    global _CACHED_CLAUDE_VER
    if _CACHED_CLAUDE_VER:
        return _CACHED_CLAUDE_VER
    cands = (
        (os.path.join(BIN_DIR, "claude.exe"), os.path.join(BIN_DIR, "claude.cmd"), "claude.exe", "claude")
        if IS_WINDOWS
        else (os.path.join(BIN_DIR, "claude"), "claude")
    )
    for cand in cands:
        try:
            resolved = cand if os.path.isabs(cand) else (shutil.which(cand) or "")
            if not resolved or not os.path.isfile(resolved):
                continue
            low_r = resolved.lower().replace("/", "\\")
            if IS_WINDOWS and ("\\windowsapps\\" in low_r or "\\anthropicclaude\\" in low_r):
                continue
            r = subprocess.run([resolved, "--version"], capture_output=True, text=True, timeout=5)
            m = re.search(r"(\d+\.\d+\.\d+)", r.stdout or "")
            if m:
                _CACHED_CLAUDE_VER = m.group(1)
                return _CACHED_CLAUDE_VER
        except Exception:
            continue
    _CACHED_CLAUDE_VER = "2.1.322"
    return _CACHED_CLAUDE_VER


def validate_alias_or_die(alias: str) -> str:
    a = (alias or "").strip()
    if not a or not ALIAS_RE.match(a):
        print(f"❌ 非法账号别名 '{alias}'：必须以字母或数字开头，仅含字母、数字、下划线或连字符 (1-32 位)。", file=sys.stderr)
        sys.exit(1)
    if a.lower() in RESERVED_VERBS:
        print(f"❌ 非法账号别名 '{a}'：该名称为 cc-switch 保留子命令，请换用如 acc1 / work1 等别名。", file=sys.stderr)
        sys.exit(1)
    return a


def validate_peer_host(peer: str) -> str:
    p = (peer or "").strip()
    if not p:
        return ""
    if p.startswith("-") or any(c in p for c in " \t\r\n'\"`$;&|<>\\"):
        raise ValueError(f"非法对端主机地址: '{peer}'")
    # 允许 user@host 或纯 host/IP
    host_part = p.split("@", 1)[1] if "@" in p else p
    user_part = p.split("@", 1)[0] if "@" in p else ""
    if user_part and not re.match(r"^[a-zA-Z0-9._-]{1,64}$", user_part):
        raise ValueError(f"非法对端 SSH 用户名: '{user_part}'")
    if host_part.startswith("[") and host_part.endswith("]"):
        ipaddress.ip_address(host_part[1:-1])
        return p
    if ":" in host_part:
        ipaddress.ip_address(host_part)
        return p
    if not PEER_HOST_RE.match(host_part):
        raise ValueError(f"非法对端主机名/IP: '{host_part}'")
    return p


def _scp_target_host(peer_host: str) -> str:
    if "@" in peer_host:
        u, h = peer_host.split("@", 1)
        return f"{u}@[{h}]" if (":" in h and not h.startswith("[")) else peer_host
    return f"[{peer_host}]" if (":" in peer_host and not peer_host.startswith("[")) else peer_host


def _curl_esc(s: str, allow_newlines: bool = False) -> str:
    val = s or ""
    if "\x00" in val:
        raise ValueError("NUL byte in curl config")
    if not allow_newlines and ("\r" in val or "\n" in val):
        raise ValueError("CR/LF control character in curl argument")
    return (
        val.replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
    )


def safe_curl(
    url: str,
    proxy_url: str = PROXY_HTTP,
    timeout: int = 8,
    method: str = "GET",
    headers: dict = None,
    body: str = None,
) -> str:
    lines = [
        'noproxy = ""',
        f'url = "{_curl_esc(url)}"',
    ]
    if proxy_url:
        lines.append(f'proxy = "{_curl_esc(proxy_url)}"')
    if method != "GET":
        lines.append(f'request = "{_curl_esc(method)}"')
    for k, v in (headers or {}).items():
        lines.append(f'header = "{_curl_esc(f"{k}: {v}")}"')
    if body is not None:
        lines.append(f'data = "{_curl_esc(body, allow_newlines=True)}"')
    try:
        curl_cmd = [CURL_BIN, "-s", "--noproxy", "", "--max-time", str(timeout)]
        if IS_WINDOWS:
            curl_cmd.append("--ssl-no-revoke")
        curl_cmd += ["-K", "-"]
        res = subprocess.run(
            curl_cmd,
            input="\n".join(lines) + "\n",
            capture_output=True,
            text=True,
            timeout=timeout + 4,
        )
        return res.stdout
    except Exception:
        return ""


@contextmanager
def global_lock(blocking: bool = True):
    ensure_base_dirs()
    raw_fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        os.chmod(LOCK_FILE, 0o600)
    except OSError:
        pass
    fd = os.fdopen(raw_fd, "r+", encoding="utf-8")
    locked = False
    try:
        if IS_WINDOWS:
            deadline = time.time() + (12.0 if blocking else 0.0)
            while True:
                try:
                    fd.seek(0)
                    if os.path.getsize(LOCK_FILE) == 0:
                        fd.write("0")
                        fd.flush()
                    fd.seek(0)
                    msvcrt.locking(fd.fileno(), msvcrt.LK_NBLCK, 1)
                    locked = True
                    break
                except OSError:
                    if not blocking or time.time() >= deadline:
                        break
                    time.sleep(0.1)
            if blocking and not locked:
                raise TimeoutError(f"等待全局锁超时 ({LOCK_FILE})")
            yield locked
        else:
            try:
                flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
                fcntl.flock(fd.fileno(), flags)
                locked = True
                yield True
            except BlockingIOError:
                yield False
    finally:
        if locked:
            try:
                if IS_WINDOWS:
                    fd.seek(0)
                    msvcrt.locking(fd.fileno(), msvcrt.LK_UNLCK, 1)
                else:
                    fcntl.flock(fd.fileno(), fcntl.LOCK_UN)
            except Exception:
                pass
        fd.close()


def atomic_write_text(path: str, text: str, mode: int = 0o600):
    parent = os.path.dirname(path)
    if parent.startswith(SAFE_DIR):
        ensure_dir_700(parent)
    else:
        os.makedirs(parent, mode=0o700, exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}.{time.time_ns()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        try:
            os.chmod(tmp, mode)
        except OSError:
            pass
        for attempt in range(4):
            try:
                os.replace(tmp, path)
                break
            except PermissionError:
                if not IS_WINDOWS or attempt == 3:
                    raise
                time.sleep(0.05)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def atomic_write_json(path: str, obj: dict, mode: int = 0o600):
    atomic_write_text(path, json.dumps(obj, indent=2, ensure_ascii=False) + "\n", mode=mode)


def detect_tailscale_ip() -> str:
    try:
        res = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=2)
        if res.returncode == 0 and res.stdout.strip():
            cand = res.stdout.strip().splitlines()[0].strip()
            ipaddress.ip_address(cand)
            return cand
    except Exception:
        pass
    return ""


def default_win_proxy(expose_ts: bool = False) -> str:
    if expose_ts:
        ts = detect_tailscale_ip()
        if ts:
            return f"{ts}:7890"
    return "127.0.0.1:7890"


def load_accounts() -> dict:
    ensure_base_dirs()
    if not os.path.exists(ACCOUNTS_FILE):
        return {
            "active": "",
            "peers": {},
            "nodes": {},
            "win_proxy": "127.0.0.1:7890",
            "expose_tailscale_proxy": False,
            "accounts": {},
        }
    try:
        with open(ACCOUNTS_FILE, "r", encoding="utf-8") as f:
            d = json.load(f)
        if not isinstance(d, dict):
            raise ValueError("根节点必须为 JSON 对象")
    except Exception as e:
        print(f"❌ 账号配置文件损坏 ({ACCOUNTS_FILE}): {e}", file=sys.stderr)
        sys.exit(1)

    if not isinstance(d.get("peers"), dict):
        d["peers"] = {}
    if not isinstance(d.get("nodes"), dict):
        d["nodes"] = {}
    if not isinstance(d.get("accounts"), dict):
        d["accounts"] = {}
    d["active"] = str(d.get("active") or "").strip()
    if "expose_tailscale_proxy" not in d:
        d["expose_tailscale_proxy"] = False
    if not d.get("win_proxy"):
        d["win_proxy"] = default_win_proxy(bool(d.get("expose_tailscale_proxy")))
    return d


def save_accounts(data: dict):
    atomic_write_json(ACCOUNTS_FILE, data, 0o600)


def get_peer_host(data: dict = None) -> str:
    d = data or {}
    raw = ""
    peers = d.get("peers") or {}
    if isinstance(peers, dict) and HOSTNAME in peers:
        raw = str(peers.get(HOSTNAME) or "").strip()
    if not raw:
        nodes = d.get("nodes") or {}
        if isinstance(nodes, dict) and nodes:
            real_nodes = {k: v for k, v in nodes.items() if k not in ("host-a", "host-b", "host-primary", "host-secondary") and v}
            if HOSTNAME in real_nodes:
                for h, ip in real_nodes.items():
                    if h != HOSTNAME and ip:
                        raw = str(ip).strip()
                        break
    if not raw:
        return ""
    try:
        return validate_peer_host(raw)
    except ValueError:
        return ""


def check_topology_warning(data: dict) -> str:
    nodes = {
        k: v
        for k, v in (data.get("nodes") or {}).items()
        if k not in ("host-a", "host-b", "host-primary", "host-secondary") and v
    }
    peers = {
        k: v
        for k, v in (data.get("peers") or {}).items()
        if k not in ("host-a", "host-b", "host-primary", "host-secondary") and v
    }
    if (nodes or peers) and not get_peer_host(data):
        if len(nodes) == 1 and HOSTNAME in nodes:
            return ""
        return f"当前主机名 '{HOSTNAME}' 未匹配 peers/nodes 配置，双机同步未生效 (可运行 `cc-switch set-peer <对端IP>` 修复)"
    return ""


def gen_totp(secret_b32: str):
    try:
        clean = (secret_b32 or "").strip().replace(" ", "").upper()
        if not clean:
            return "N/A", 0
        pad = (8 - len(clean) % 8) % 8
        key = base64.b32decode(clean + "=" * pad)
        now = int(time.time())
        rem = 30 - (now % 30)
        msg = struct.pack(">Q", now // 30)
        h = hmac.new(key, msg, hashlib.sha1).digest()
        offset = h[-1] & 0x0F
        code = (struct.unpack(">I", h[offset : offset + 4])[0] & 0x7FFFFFFF) % 1000000
        return f"{code:06d}", rem
    except Exception:
        return "N/A", 0


def profile_paths(acc_key: str) -> dict:
    validate_alias_or_die(acc_key)
    pdir = os.path.join(PROFILES_DIR, acc_key)
    hdir = os.path.join(pdir, "home")
    for sub in (pdir, hdir, os.path.join(hdir, "projects"), os.path.join(hdir, "sessions")):
        ensure_dir_700(sub)
    return {
        "pdir": pdir,
        "id_file": os.path.join(pdir, "identity.json"),
        "gitconfig": os.path.join(pdir, "gitconfig"),
        "home": hdir,
        "cred": os.path.join(hdir, ".credentials.json"),
        "claude_json": os.path.join(hdir, ".claude.json"),
        "settings": os.path.join(hdir, "settings.json"),
        "projects": os.path.join(hdir, "projects"),
    }


def ensure_profile_identity(acc_key: str) -> dict:
    paths = profile_paths(acc_key)
    id_file = paths["id_file"]
    data = {}
    if os.path.exists(id_file):
        try:
            with open(id_file, "r", encoding="utf-8") as f:
                loaded = json.load(f)
            if isinstance(loaded, dict):
                data = loaded
        except Exception:
            data = {}

    changed = False
    for hex_key in ("userID", "machineID", "summonSidKey"):
        val = str(data.get(hex_key) or "")
        if len(val) != 64:
            data[hex_key] = secrets.token_hex(32)
            changed = True
    if not data.get("remoteControlMachineId"):
        data["remoteControlMachineId"] = str(uuid.uuid4())
        changed = True
    if not data.get("firstStartTime"):
        seed_hex = hashlib.sha256((acc_key + ":" + data["userID"]).encode()).hexdigest()
        jitter_sec = int(seed_hex[:6], 16) % (86400 * 7) + 3600
        jitter_ms = int(seed_hex[6:10], 16) % 1000
        dt = datetime.now(timezone.utc).replace(microsecond=0) - timedelta(seconds=jitter_sec)
        data["firstStartTime"] = dt.strftime("%Y-%m-%dT%H:%M:%S") + f".{jitter_ms:03d}Z"
        changed = True
    if not data.get("startupBaseline"):
        seed_hex = hashlib.sha256(("startups:" + data["userID"]).encode()).hexdigest()
        data["startupBaseline"] = 6 + (int(seed_hex[:4], 16) % 18)
        changed = True
    if "oauthAccount" not in data:
        data["oauthAccount"] = None
        changed = True
    if "claudeCodeFirstTokenDate" not in data:
        data["claudeCodeFirstTokenDate"] = None
        changed = True

    if changed or not os.path.exists(id_file):
        atomic_write_json(id_file, data, 0o600)
    return data


def parse_valid_cred(raw_text: str):
    if not raw_text or len(raw_text.strip()) <= 20:
        return 0, None
    try:
        d = json.loads(raw_text)
        oauth = d.get("claudeAiOauth") or {}
        at = oauth.get("accessToken", "")
        rt = oauth.get("refreshToken", "")
        exp = int(oauth.get("expiresAt", 0) or 0)
        if at and rt and exp > 0:
            return exp, raw_text
    except Exception:
        pass
    return 0, None


def harvest_profile_oauth_meta(acc_key: str, expected_email: str = ""):
    """从该账号专属 home/.claude.json 提取首次登录生成的 oauthAccount，固化到 identity.json。"""
    paths = profile_paths(acc_key)
    id_data = ensure_profile_identity(acc_key)
    cj_path = paths["claude_json"]
    if not os.path.exists(cj_path):
        return id_data
    try:
        with open(cj_path, "r", encoding="utf-8") as f:
            cj = json.load(f)
        oa = cj.get("oauthAccount")
        if isinstance(oa, dict) and oa.get("accountUuid"):
            if not expected_email or str(oa.get("emailAddress") or "").lower() == expected_email.lower():
                changed = False
                if id_data.get("oauthAccount") != oa:
                    id_data["oauthAccount"] = oa
                    changed = True
                ftd = cj.get("claudeCodeFirstTokenDate")
                if ftd and id_data.get("claudeCodeFirstTokenDate") != ftd:
                    id_data["claudeCodeFirstTokenDate"] = ftd
                    changed = True
                if changed:
                    atomic_write_json(paths["id_file"], id_data, 0o600)
    except Exception:
        pass
    return id_data


def build_clean_claude_json(existing_cj: dict, id_data: dict, has_cred: bool) -> dict:
    """在保留账号已有用户偏好与自定义 MCP 的前提下，锁定 6 维独立指纹并关闭后台自动更新。"""
    cver = get_claude_version()
    clean = dict(existing_cj) if isinstance(existing_cj, dict) else {}
    for k_strip in ("oauthAccount", "userEmail", "accountUuid", "organizationUuid"):
        clean.pop(k_strip, None)

    baseline = int(id_data.get("startupBaseline") or 8)
    cur_startups = clean.get("numStartups")
    clean["numStartups"] = max(int(cur_startups) if isinstance(cur_startups, int) else baseline, baseline)
    clean["installMethod"] = "native"
    clean["autoUpdates"] = False
    clean["autoUpdatesProtectedForNative"] = True
    clean["hasCompletedOnboarding"] = True
    clean.setdefault("lastOnboardingVersion", cver)
    clean.setdefault("lastReleaseNotesSeen", cver)
    clean["userID"] = id_data["userID"]
    clean["machineID"] = id_data["machineID"]
    clean["summonSidKey"] = id_data["summonSidKey"]
    clean["remoteControlMachineId"] = id_data["remoteControlMachineId"]
    clean["firstStartTime"] = id_data["firstStartTime"]
    if not isinstance(clean.get("projects"), dict):
        clean["projects"] = {}

    # 锁定第一方遥测熔断缓存开关
    gb = dict(clean.get("cachedGrowthBookFeatures")) if isinstance(clean.get("cachedGrowthBookFeatures"), dict) else {}
    gb["tengu_frond_boric"] = {"firstParty": True}
    clean["cachedGrowthBookFeatures"] = gb

    if id_data.get("claudeCodeFirstTokenDate"):
        clean["claudeCodeFirstTokenDate"] = id_data["claudeCodeFirstTokenDate"]
    if has_cred and id_data.get("oauthAccount"):
        clean["oauthAccount"] = id_data["oauthAccount"]
    return clean


def _sanitize_git_identity(acc_key: str, email: str) -> tuple:
    clean_em = re.sub(r"[\r\n\x00\"'\\\[\]#;]", "", (email or "").strip())
    raw_user = clean_em.split("@")[0] if "@" in clean_em else acc_key
    git_user = re.sub(r"[^a-zA-Z0-9._-]", "", raw_user) or acc_key
    git_email = clean_em if "@" in clean_em else f"{acc_key}@users.noreply.github.com"
    return git_user, git_email


def build_profile_gitconfig(acc_key: str, email: str, git_path: str):
    git_user, git_email = _sanitize_git_identity(acc_key, email)
    # 严禁 [include] 宿主机 ~/.gitconfig！彻底阻断 user.signingkey / github.user / credential.helper 跨号泄露
    cfg_body = (
        "[user]\n"
        f"\tname = {git_user}\n"
        f"\temail = {git_email}\n"
        "[commit]\n"
        "\tgpgsign = false\n"
    )
    atomic_write_text(git_path, cfg_body, 0o600)

    # 生成仅在 cc-safe 会话 PATH 中生效的 git 垫片:
    # 1) 防止 Claude 内部 gitStatus 剥离 GIT_CONFIG_GLOBAL 后回退读取宿主机 ~/.gitconfig
    # 2) 通过 -c 命令行级覆盖仓库本地 .git/config [user]，防止多号在同一目录工作时暴露共享仓库本地作者名
    real_git = "/usr/bin/git"
    for p in os.environ.get("PATH", "").split(":"):
        if p.rstrip("/").endswith("/.claude-safe/libexec"):
            continue
        cand = os.path.join(p, "git")
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            real_git = cand
            break
    libexec_dir = os.path.join(SAFE_DIR, "libexec")
    ensure_dir_700(libexec_dir)
    if IS_WINDOWS:
        real_git_win = "git.exe"
        for p in os.environ.get("PATH", "").split(os.pathsep):
            if not p or os.path.normcase(os.path.abspath(p)) == os.path.normcase(os.path.abspath(libexec_dir)):
                continue
            cand_w = os.path.join(p, "git.exe")
            if os.path.isfile(cand_w):
                real_git_win = cand_w
                break
        win_shim_py = os.path.join(libexec_dir, "_git_shim.py")
        win_py_body = (
            "import os, subprocess, sys\n"
            f"REAL_GIT = {json.dumps(real_git_win)}\n"
            'root = os.environ.get("CC_SAFE_ROOT") or os.path.join(os.path.expanduser("~"), ".claude-safe")\n'
            'acc = os.environ.get("CC_SAFE_ACCOUNT", "")\n'
            'gc = os.path.join(root, "profiles", acc, "gitconfig") if acc else ""\n'
            'if not (gc and os.path.isfile(gc)):\n'
            '    ccd = os.environ.get("CLAUDE_CONFIG_DIR", "")\n'
            '    if ccd and os.path.isfile(os.path.join(os.path.dirname(ccd), "gitconfig")):\n'
            '        gc = os.path.join(os.path.dirname(ccd), "gitconfig")\n'
            '    elif os.environ.get("GIT_CONFIG_GLOBAL") and os.path.isfile(os.environ["GIT_CONFIG_GLOBAL"]):\n'
            '        gc = os.environ["GIT_CONFIG_GLOBAL"]\n'
            "extra = []\n"
            "if gc and os.path.isfile(gc):\n"
            '    os.environ["GIT_CONFIG_GLOBAL"] = gc\n'
            '    os.environ["GIT_CONFIG_NOSYSTEM"] = "1"\n'
            '    nm = subprocess.run([REAL_GIT, "config", "--file", gc, "user.name"], capture_output=True, text=True).stdout.strip()\n'
            '    em = subprocess.run([REAL_GIT, "config", "--file", gc, "user.email"], capture_output=True, text=True).stdout.strip()\n'
            "    if nm and em:\n"
            '        extra = ["-c", f"user.name={nm}", "-c", f"user.email={em}", "-c", "commit.gpgsign=false"]\n'
            "sys.exit(subprocess.call([REAL_GIT, *extra, *sys.argv[1:]]))\n"
        )
        atomic_write_text(win_shim_py, win_py_body, 0o600)
        esc_py = sys.executable.replace("%", "%%")
        esc_shim = win_shim_py.replace("%", "%%")
        cmd_shim = (
            "@echo off\r\n"
            "setlocal DisableDelayedExpansion\r\n"
            f'"{esc_py}" "{esc_shim}" %*\r\n'
            "exit /b %ERRORLEVEL%\r\n"
        )
        atomic_write_text(os.path.join(libexec_dir, "git.cmd"), cmd_shim, 0o755)
        return

    shim_path = os.path.join(libexec_dir, "git")
    quoted_git = shlex.quote(real_git)
    shim_code = (
        "#!/usr/bin/env bash\n"
        "_CC_GC=\"\"\n"
        '_CC_ROOT="${CC_SAFE_ROOT:-$HOME/.claude-safe}"\n'
        'if [ -n "${CC_SAFE_ACCOUNT:-}" ] && [ -f "$_CC_ROOT/profiles/$CC_SAFE_ACCOUNT/gitconfig" ]; then\n'
        '    _CC_GC="$_CC_ROOT/profiles/$CC_SAFE_ACCOUNT/gitconfig"\n'
        'elif [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ -f "$(dirname "$CLAUDE_CONFIG_DIR")/gitconfig" ]; then\n'
        '    _CC_GC="$(dirname "$CLAUDE_CONFIG_DIR")/gitconfig"\n'
        'elif [ -n "${GIT_CONFIG_GLOBAL:-}" ] && [ -f "$GIT_CONFIG_GLOBAL" ]; then\n'
        '    _CC_GC="$GIT_CONFIG_GLOBAL"\n'
        "fi\n"
        'if [ -n "$_CC_GC" ]; then\n'
        '    export GIT_CONFIG_GLOBAL="$_CC_GC"\n'
        '    export GIT_CONFIG_NOSYSTEM="1"\n'
        f'    _NAME="$({quoted_git} config --file "$_CC_GC" user.name 2>/dev/null || true)"\n'
        f'    _MAIL="$({quoted_git} config --file "$_CC_GC" user.email 2>/dev/null || true)"\n'
        '    if [ -n "$_NAME" ] && [ -n "$_MAIL" ]; then\n'
        f'        exec {quoted_git} -c "user.name=$_NAME" -c "user.email=$_MAIL" -c "commit.gpgsign=false" "$@"\n'
        "    fi\n"
        "fi\n"
        f"exec {quoted_git} \"$@\"\n"
    )
    atomic_write_text(shim_path, shim_code, 0o755)


def build_clean_settings(
    tz_val: str,
    existing_settings: dict = None,
    profile_home: str = "",
    profile_gitconfig: str = "",
    git_user: str = "",
    git_email: str = "",
    isolate_git: bool = True,
) -> dict:
    base = dict(existing_settings) if isinstance(existing_settings, dict) else {}
    merged_env = dict(base.get("env")) if isinstance(base.get("env"), dict) else {}
    for k_bad in (
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_CUSTOM_HEADERS",
        "CLAUDE_SUB2API_MANAGED",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "CLAUDE_CODE_ENABLE_TELEMETRY",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_EXPORTER_OTLP_HEADERS",
        "CLAUDE_CODE_ORGANIZATION_UUID",
        "CLAUDE_CODE_ACCOUNT_UUID",
        "CLAUDE_CODE_HARBOR_KITE_CLOUD",
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "FTP_PROXY",
        "ftp_proxy",
        "RSYNC_PROXY",
    ):
        merged_env.pop(k_bad, None)

    safe_tz = (tz_val or "").strip() or "America/New_York"
    dyn_http, dyn_socks, _, _ = get_tunnel_proxy_urls()
    enforced_env = {
        "HTTPS_PROXY": dyn_http,
        "https_proxy": dyn_http,
        "HTTP_PROXY": dyn_http,
        "http_proxy": dyn_http,
        "ALL_PROXY": dyn_socks,
        "all_proxy": dyn_socks,
        "GRPC_PROXY": dyn_http,
        "grpc_proxy": dyn_http,
        "NO_PROXY": "localhost,127.0.0.1,::1",
        "no_proxy": "localhost,127.0.0.1,::1",
        "NODE_OPTIONS": "--dns-result-order=ipv4first",
        "BUN_FEATURE_FLAG_DISABLE_IPV6": "1",
        "DISABLE_TELEMETRY": "1",
        "DO_NOT_TRACK": "1",
        "DISABLE_ERROR_REPORTING": "1",
        "DISABLE_AUTOUPDATER": "1",
        "DISABLE_GROWTHBOOK": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
        "TZ": safe_tz,
    }
    if profile_home:
        enforced_env["CLAUDE_SECURESTORAGE_CONFIG_DIR"] = profile_home
        enforced_env["ANTHROPIC_CONFIG_DIR"] = profile_home
        enforced_env["GH_CONFIG_DIR"] = os.path.join(profile_home, ".config", "gh")
    if isolate_git and profile_gitconfig:
        enforced_env["GIT_CONFIG_GLOBAL"] = profile_gitconfig
        enforced_env["GIT_CONFIG_NOSYSTEM"] = "1"
        if git_user:
            enforced_env["GIT_AUTHOR_NAME"] = git_user
            enforced_env["GIT_COMMITTER_NAME"] = git_user
        if git_email:
            enforced_env["GIT_AUTHOR_EMAIL"] = git_email
            enforced_env["GIT_COMMITTER_EMAIL"] = git_email
            enforced_env["EMAIL"] = git_email
    else:
        for gk in ("GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM", "GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL", "GIT_COMMITTER_NAME", "GIT_COMMITTER_EMAIL", "EMAIL"):
            merged_env.pop(gk, None)

    merged_env.update(enforced_env)
    base["env"] = merged_env
    return base


def _has_live_session_for_account(acc_key: str) -> bool:
    for p in find_cc_safe_processes():
        if p.get("env", {}).get("CC_SAFE_ACCOUNT") == acc_key:
            return True
    return False


def apply_profile_locally(acc_key: str, if_idle: bool = False) -> tuple:
    data = load_accounts()
    acc = data.get("accounts", {}).get(acc_key, {})
    paths = profile_paths(acc_key)
    id_data = harvest_profile_oauth_meta(acc_key, acc.get("email", ""))
    isolate_git = bool(data.get("isolate_git_config", True))
    git_user, git_email = _sanitize_git_identity(acc_key, acc.get("email", ""))
    if isolate_git:
        build_profile_gitconfig(acc_key, acc.get("email", ""), paths["gitconfig"])
    elif os.path.exists(paths["gitconfig"]):
        try:
            os.remove(paths["gitconfig"])
        except OSError:
            pass

    exp, _ = parse_valid_cred(open(paths["cred"], "r", encoding="utf-8").read()) if os.path.exists(paths["cred"]) else (0, None)
    has_cred = exp > 0

    live_running = if_idle and _has_live_session_for_account(acc_key)
    if not live_running:
        for sub in ("telemetry", "statsig", "cache"):
            t = os.path.join(paths["home"], sub)
            if os.path.exists(t) and not os.path.islink(t):
                shutil.rmtree(t, ignore_errors=True)

    old_st = {}
    if os.path.exists(paths["settings"]):
        try:
            with open(paths["settings"], "r", encoding="utf-8") as f:
                old_st = json.load(f)
        except Exception:
            old_st = {}

    atomic_write_json(
        paths["settings"],
        build_clean_settings(
            acc.get("tz", "America/New_York"),
            old_st,
            profile_home=paths["home"],
            profile_gitconfig=paths["gitconfig"],
            git_user=git_user,
            git_email=git_email,
            isolate_git=isolate_git,
        ),
        0o600,
    )

    if not live_running or not os.path.exists(paths["claude_json"]):
        old_cj = {}
        if os.path.exists(paths["claude_json"]):
            try:
                with open(paths["claude_json"], "r", encoding="utf-8") as f:
                    old_cj = json.load(f)
            except Exception:
                old_cj = {}
        atomic_write_json(paths["claude_json"], build_clean_claude_json(old_cj, id_data, has_cred), 0o600)

    return has_cred, id_data


def write_tunnel_configs(acc: dict, expose_tailscale: bool = False):
    _, _, cur_http_l, cur_socks_l = get_tunnel_proxy_urls()
    obj = {
        "active_account": str(acc.get("id") or ""),
        "expected_ip": str(acc.get("ip") or "").strip(),
        "us_proxy": str(acc.get("proxy") or "").strip(),
        "http_listen": cur_http_l,
        "socks_listen": cur_socks_l,
        "expose_tailscale_proxy": bool(expose_tailscale),
    }
    atomic_write_json(TUNNEL_JSON, obj, 0o600)

    env_text = (
        "# Claude Code US Fixed Tunnel Configuration (Managed by cc-switch)\n"
        f"ACTIVE_ACCOUNT={shlex.quote(obj['active_account'])}\n"
        f"EXPECTED_IP={shlex.quote(obj['expected_ip'])}\n"
        f"US_PROXY={shlex.quote(obj['us_proxy'])}\n"
        f"HTTP_LISTEN={shlex.quote(cur_http_l)}\n"
        f"SOCKS_LISTEN={shlex.quote(cur_socks_l)}\n"
    )
    atomic_write_text(TUNNEL_ENV, env_text, 0o600)


def probe_tunnel_trace(proxy_url: str = None, timeout: int = 6) -> dict:
    if not proxy_url:
        proxy_url, _, _, _ = get_tunnel_proxy_urls()
    out = safe_curl("https://api.anthropic.com/cdn-cgi/trace", proxy_url=proxy_url, timeout=timeout)
    res = {}
    for line in out.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            res[k.strip()] = v.strip()
    return res


def verify_active_egress_or_die(acc: dict):
    expected_ip = str(acc.get("ip") or "").strip()
    if not expected_ip:
        print(f"❌ [熔断] 账号 [{acc.get('id', '?')}] 未绑定 EXPECTED_IP，严禁发包！")
        sys.exit(1)
    dyn_http, dyn_socks, _, _ = get_tunnel_proxy_urls()
    trace_http = probe_tunnel_trace(dyn_http, timeout=6)
    trace_socks = probe_tunnel_trace(dyn_socks, timeout=6)
    live_ip = trace_http.get("ip", "")
    live_loc = trace_http.get("loc", "")
    socks_ip = trace_socks.get("ip", "")
    socks_loc = trace_socks.get("loc", "")
    if live_loc != "US" or not live_ip:
        print(f"❌ [熔断] 本机 HTTP 代理隧道不可用或非 US 出口 (ip={live_ip or '无'}, loc={live_loc or '超时'})！")
        sys.exit(1)
    if live_ip != expected_ip:
        print(f"❌ [熔断] HTTP 出口 IP ({live_ip}) 与账号 [{acc['id']}] 绑定 IP ({expected_ip}) 不匹配！严禁发包！")
        sys.exit(1)
    if socks_loc != "US" or socks_ip != expected_ip:
        print(f"❌ [熔断] SOCKS5h 出口异常 (ip={socks_ip or '无'}, loc={socks_loc or '超时'}, 绑定={expected_ip})！严禁发包！")
        sys.exit(1)
    return live_ip


def _is_claude_code_binary(exe_path: str, argv: list) -> bool:
    candidates = [exe_path or ""] + [a for a in (argv or [])[:4] if a]
    for c in candidates:
        c_norm = c.strip()
        base = os.path.basename(c_norm)
        if (
            base == "claude"
            or c_norm.endswith("/bin/claude")
            or "/.local/share/claude/versions/" in c_norm
            or "@anthropic-ai/claude-code" in c_norm
            or ("anthropic.claude-code" in c_norm and "/native-binary/claude" in c_norm)
        ):
            return True
    return False


def _is_cc_safe_explicit(argv: list, env_map: dict) -> bool:
    proc_root = os.path.abspath(env_map["CC_SAFE_ROOT"]) if env_map.get("CC_SAFE_ROOT") else ""
    if proc_root and proc_root != SAFE_DIR:
        return False
    cfg_dir = os.path.abspath(env_map["CLAUDE_CONFIG_DIR"]) if env_map.get("CLAUDE_CONFIG_DIR") else ""
    if cfg_dir and ".claude-safe" in cfg_dir and not (cfg_dir == SAFE_DIR or cfg_dir.startswith(SAFE_DIR + "/")):
        return False
    if env_map.get("CC_SAFE_MANAGED") == "1":
        return True
    if cfg_dir and (cfg_dir == SAFE_DIR or cfg_dir.startswith(SAFE_DIR + "/")):
        return True
    cmd_first_two = " ".join((argv or [])[:2])
    if not proc_root and (any(a.endswith("/cc-safe") for a in (argv or [])[:2]) or "/bin/cc-safe" in cmd_first_two):
        if os.environ.get("CC_AUDIT_SANDBOX") != "1":
            return True
    return False


def _is_relay_managed(argv: list, env_map: dict) -> bool:
    # 严禁将任何显式标记为 CC_SAFE_MANAGED 或 ~/.claude-safe 的进程误判为中转！
    if _is_cc_safe_explicit(argv, env_map):
        return False
    if env_map.get("CLAUDE_SUB2API_MANAGED") == "1":
        return True
    sub2_cfg = os.path.abspath(os.path.join(HOME, ".claude"))
    if env_map.get("CLAUDE_CONFIG_DIR") and os.path.abspath(env_map["CLAUDE_CONFIG_DIR"]) == sub2_cfg:
        return True
    cmd_join = " ".join(argv or [])
    if "sub2api.settings.json" in cmd_join or "/bin/claude-sub2api" in cmd_join:
        return True
    return False


def _is_infra_daemon(info: dict) -> bool:
    argv = info.get("argv") or []
    exe = info.get("exe") or ""
    comm = info.get("comm") or ""
    if comm == "gost" or exe.endswith("/gost") or (argv and argv[0].endswith("/gost")):
        return True
    if any(a.endswith("/cc-us-tunnel") for a in argv[:2]):
        return True
    return False


def _scan_user_proc_tree() -> tuple:
    uid = os.getuid()
    my_pid = os.getpid()
    procs = {}
    children = {}
    all_ppids = {}

    for pdir in glob.glob("/proc/[0-9]*"):
        base = os.path.basename(pdir)
        if not base.isdigit():
            continue
        pid = int(base)
        try:
            stat_raw = open(f"{pdir}/stat", "rb").read().decode("utf-8", "ignore")
            rparen = stat_raw.rfind(")")
            if rparen == -1:
                continue
            comm = stat_raw[stat_raw.find("(") + 1 : rparen]
            rest = stat_raw[rparen + 2 :].split()
            state = rest[0] if rest else ""
            ppid = int(rest[1]) if len(rest) > 1 else 0
            starttime = int(rest[19]) if len(rest) > 19 else 0
            all_ppids[pid] = ppid

            if os.stat(pdir).st_uid != uid or state == "Z":
                continue

            cmdline_bytes = open(f"{pdir}/cmdline", "rb").read()
            argv = [x.decode("utf-8", "ignore") for x in cmdline_bytes.split(b"\x00") if x]
            try:
                exe = os.readlink(f"{pdir}/exe")
            except Exception:
                exe = ""

            env_map = {}
            try:
                env_bytes = open(f"{pdir}/environ", "rb").read()
                for item in env_bytes.split(b"\x00"):
                    if b"=" in item:
                        k, v = item.split(b"=", 1)
                        env_map[k.decode("utf-8", "ignore")] = v.decode("utf-8", "ignore")
            except Exception:
                pass

            procs[pid] = {
                "pid": pid,
                "ppid": ppid,
                "starttime": starttime,
                "state": state,
                "comm": comm,
                "exe": exe,
                "argv": argv,
                "env": env_map,
            }
            children.setdefault(ppid, []).append(pid)
        except Exception:
            continue

    ancestors = {my_pid}
    cur = my_pid
    for _ in range(64):
        parent = all_ppids.get(cur, 0)
        if parent <= 1 or parent in ancestors:
            break
        ancestors.add(parent)
        cur = parent

    return procs, children, ancestors


def _get_k32():
    k32 = ctypes.windll.kernel32
    if not getattr(_get_k32, "_configured", False):
        k32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
        k32.OpenProcess.restype = wintypes.HANDLE
        k32.GetProcessTimes.argtypes = [
            wintypes.HANDLE,
            ctypes.POINTER(wintypes.FILETIME),
            ctypes.POINTER(wintypes.FILETIME),
            ctypes.POINTER(wintypes.FILETIME),
            ctypes.POINTER(wintypes.FILETIME),
        ]
        k32.GetProcessTimes.restype = wintypes.BOOL
        k32.TerminateProcess.argtypes = [wintypes.HANDLE, wintypes.UINT]
        k32.TerminateProcess.restype = wintypes.BOOL
        k32.CreateToolhelp32Snapshot.argtypes = [wintypes.DWORD, wintypes.DWORD]
        k32.CreateToolhelp32Snapshot.restype = wintypes.HANDLE
        k32.Process32FirstW.argtypes = [wintypes.HANDLE, ctypes.c_void_p]
        k32.Process32FirstW.restype = wintypes.BOOL
        k32.Process32NextW.argtypes = [wintypes.HANDLE, ctypes.c_void_p]
        k32.Process32NextW.restype = wintypes.BOOL
        k32.CloseHandle.argtypes = [wintypes.HANDLE]
        k32.CloseHandle.restype = wintypes.BOOL
        _get_k32._configured = True
    return k32


def _win_proc_create_time(pid: int) -> int:
    if not IS_WINDOWS:
        return 0
    try:
        k32 = _get_k32()
        h = k32.OpenProcess(0x1000, False, int(pid))
        if not h:
            return 0
        try:
            ct, et, kt, ut = wintypes.FILETIME(), wintypes.FILETIME(), wintypes.FILETIME(), wintypes.FILETIME()
            if k32.GetProcessTimes(h, ctypes.byref(ct), ctypes.byref(et), ctypes.byref(kt), ctypes.byref(ut)):
                return (int(ct.dwHighDateTime) << 32) | int(ct.dwLowDateTime)
        finally:
            k32.CloseHandle(h)
    except Exception:
        pass
    return 0


def _win_find_cc_safe_processes(only_rogue_for_account: str = None, exclude_account: str = None) -> list:
    k32 = _get_k32()
    my_pid = os.getpid()
    INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value

    class PROCESSENTRY32W(ctypes.Structure):
        _fields_ = [
            ("dwSize", wintypes.DWORD),
            ("cntUsage", wintypes.DWORD),
            ("th32ProcessID", wintypes.DWORD),
            ("th32DefaultHeapID", ctypes.c_size_t),
            ("th32ModuleID", wintypes.DWORD),
            ("cntThreads", wintypes.DWORD),
            ("th32ParentProcessID", wintypes.DWORD),
            ("pcPriClassBase", wintypes.LONG),
            ("dwFlags", wintypes.DWORD),
            ("szExeFile", wintypes.WCHAR * 260),
        ]

    procs = {}
    children = {}
    snap = k32.CreateToolhelp32Snapshot(0x00000002, 0)
    if snap and snap != INVALID_HANDLE_VALUE:
        try:
            pe = PROCESSENTRY32W()
            pe.dwSize = ctypes.sizeof(PROCESSENTRY32W)
            if k32.Process32FirstW(snap, ctypes.byref(pe)):
                while True:
                    pid = int(pe.th32ProcessID)
                    ppid = int(pe.th32ParentProcessID)
                    ct = _win_proc_create_time(pid)
                    if ct > 0:
                        procs[pid] = {
                            "pid": pid,
                            "ppid": ppid,
                            "starttime": ct,
                            "comm": pe.szExeFile,
                            "argv": [pe.szExeFile],
                            "env": {},
                        }
                        children.setdefault(ppid, []).append(pid)
                    if not k32.Process32NextW(snap, ctypes.byref(pe)):
                        break
        finally:
            k32.CloseHandle(snap)

    excluded = {my_pid}
    cur = my_pid
    for _ in range(64):
        p = (procs.get(cur) or {}).get("ppid", 0)
        if p <= 0 or p in excluded:
            break
        excluded.add(p)
        cur = p

    # 排除 claude-sub2api 中转会话树
    sub2_sess_dir = os.path.join(LOCK_DIR, "sub2api_sessions")
    if os.path.isdir(sub2_sess_dir):
        relay_roots = []
        for sf in glob.glob(os.path.join(sub2_sess_dir, "*.json")):
            try:
                sm = json.load(open(sf, "r", encoding="utf-8"))
                spid = int(sm.get("pid") or 0)
                sct = int(sm.get("create_time") or 0)
                scpid = int(sm.get("claude_pid") or 0)
                alive_s = spid in procs and (not sct or procs[spid]["starttime"] == sct)
                alive_sc = scpid in procs
                if not alive_s and not alive_sc:
                    try:
                        os.remove(sf)
                    except OSError:
                        pass
                    continue
                if alive_s:
                    relay_roots.append(spid)
                if alive_sc:
                    relay_roots.append(scpid)
            except Exception:
                pass
        stk = list(relay_roots)
        while stk:
            rpid = stk.pop()
            if rpid in excluded or rpid not in procs:
                continue
            excluded.add(rpid)
            stk.extend(children.get(rpid, []))

    roots = set()
    managed_tree_pids = set()
    norm_safe_dir = os.path.normcase(SAFE_DIR)
    win_sess_dir = os.path.join(LOCK_DIR, "win_sessions")
    if os.path.isdir(win_sess_dir):
        for mf in glob.glob(os.path.join(win_sess_dir, "*.json")):
            try:
                m = json.load(open(mf, "r", encoding="utf-8"))
                m_root = os.path.normcase(os.path.abspath(m.get("safe_root") or SAFE_DIR))
                if m_root != norm_safe_dir:
                    continue
                mpid = int(m.get("pid") or 0)
                mct = int(m.get("create_time") or 0)
                macc = str(m.get("account") or "")
                cpid = int(m.get("claude_pid") or 0)
                cct = int(m.get("claude_create_time") or 0)
                alive_launcher = mpid in procs and (not mct or procs[mpid]["starttime"] == mct)
                alive_claude = cpid in procs and (not cct or procs[cpid]["starttime"] == cct)
                if not alive_launcher and not alive_claude:
                    try:
                        os.remove(mf)
                    except OSError:
                        pass
                    continue
                for r_m in ([mpid] if alive_launcher else []) + ([cpid] if alive_claude else []):
                    procs[r_m]["env"] = {"CC_SAFE_ACCOUNT": macc, "CC_SAFE_MANAGED": "1"}
                    stk_m = [r_m]
                    while stk_m:
                        x_m = stk_m.pop()
                        if x_m not in managed_tree_pids and x_m in procs:
                            managed_tree_pids.add(x_m)
                            stk_m.extend(children.get(x_m, []))
                if exclude_account and macc == exclude_account:
                    continue
                if only_rogue_for_account and macc == only_rogue_for_account:
                    continue
                if alive_launcher:
                    roots.add(mpid)
                if alive_claude:
                    roots.add(cpid)
            except Exception:
                pass

    # 非沙箱模式下，捕获绕过 cc-safe 直接裸跑的野生 claude.exe 进程
    if os.environ.get("CC_AUDIT_SANDBOX") != "1":
        for pid, info in procs.items():
            if pid in excluded or pid in managed_tree_pids:
                continue
            if info["comm"].lower() == "claude.exe":
                roots.add(pid)

    ordered = []
    visited = set()

    def _dfs(c_pid: int):
        if c_pid in visited or c_pid in excluded or c_pid not in procs:
            return
        if procs[c_pid]["comm"].lower() == "gost.exe":
            return
        visited.add(c_pid)
        for ch in children.get(c_pid, []):
            _dfs(ch)
        ordered.append(procs[c_pid])

    for r in sorted(roots):
        _dfs(r)
    return ordered


def find_cc_safe_processes(only_rogue_for_account: str = None, exclude_account: str = None) -> list:
    if IS_WINDOWS:
        return _win_find_cc_safe_processes(only_rogue_for_account=only_rogue_for_account, exclude_account=exclude_account)
    """
    精准查找当前 SAFE_DIR 作用域下的个人订阅 / cc-safe 会话进程及其完整后代进程树。
    - 100% 排除: 当前 cc-switch 自身及祖先链路、gost/cc-us-tunnel 基础设施、claude-sub2api 中转进程树
      (但如果中转终端内部用户启动了 CC_SAFE_MANAGED=1 的 cc-safe，仍能穿透识别并纳入管理！)。
    """
    procs, children, ancestors = _scan_user_proc_tree()
    excluded = set(ancestors)
    is_audit_sandbox = os.environ.get("CC_AUDIT_SANDBOX") == "1"

    relay_roots = []
    for pid, info in procs.items():
        if _is_infra_daemon(info):
            excluded.add(pid)
            continue
        if _is_relay_managed(info["argv"], info["env"]):
            relay_roots.append(pid)

    stack = list(relay_roots)
    while stack:
        rpid = stack.pop()
        if rpid in excluded or rpid not in procs:
            continue
        if _is_cc_safe_explicit(procs[rpid]["argv"], procs[rpid]["env"]):
            continue
        excluded.add(rpid)
        stack.extend(children.get(rpid, []))

    expected_cfg = (
        os.path.join(PROFILES_DIR, only_rogue_for_account, "home")
        if (only_rogue_for_account and ALIAS_RE.match(only_rogue_for_account))
        else ""
    )
    roots = set()

    for pid, info in procs.items():
        if pid in excluded:
            continue
        env = info["env"]
        argv = info["argv"]

        # 若进程显式绑定了其它沙箱的 CC_SAFE_ROOT，则不属于当前实例
        proc_root = os.path.abspath(env["CC_SAFE_ROOT"]) if env.get("CC_SAFE_ROOT") else ""
        if proc_root and proc_root != SAFE_DIR:
            continue

        is_cc_safe_owned = _is_cc_safe_explicit(argv, env)
        is_bare_claude = (not is_audit_sandbox) and _is_claude_code_binary(info["exe"], argv) and not env.get("ANTHROPIC_BASE_URL")

        if not (is_cc_safe_owned or is_bare_claude):
            continue

        acc_tag = env.get("CC_SAFE_ACCOUNT", "")
        if exclude_account and is_cc_safe_owned and acc_tag == exclude_account:
            continue

        if only_rogue_for_account:
            cfg_dir = os.path.abspath(env["CLAUDE_CONFIG_DIR"]) if env.get("CLAUDE_CONFIG_DIR") else ""
            is_valid_current = (
                is_cc_safe_owned
                and acc_tag == only_rogue_for_account
                and (not cfg_dir or cfg_dir == expected_cfg)
            )
            if not is_valid_current:
                roots.add(pid)
        else:
            roots.add(pid)

    # 递归收集全部子孙并按树深度倒序 (叶子优先) 排列，确保先杀子孙再杀 subreaper/父进程
    ordered = []
    visited = set()

    def _dfs_postorder(curr: int):
        if curr in visited or curr in excluded or curr not in procs:
            return
        visited.add(curr)
        for ch in children.get(curr, []):
            _dfs_postorder(ch)
        ordered.append(procs[curr])

    for r in sorted(roots):
        _dfs_postorder(r)

    return ordered


def _pid_matches_starttime(pid: int, expected_st: int) -> bool:
    if IS_WINDOWS:
        ct = _win_proc_create_time(pid)
        return ct > 0 and ct == expected_st
    try:
        if os.stat(f"/proc/{pid}").st_uid != os.getuid():
            return False
        stat_raw = open(f"/proc/{pid}/stat", "rb").read().decode("utf-8", "ignore")
        rparen = stat_raw.rfind(")")
        if rparen == -1:
            return False
        rest = stat_raw[rparen + 2 :].split()
        state = rest[0] if rest else ""
        st = int(rest[19]) if len(rest) > 19 else -1
        return state != "Z" and st == expected_st
    except Exception:
        return False


def _kill_single_pid(pid: int, sig: int):
    if IS_WINDOWS:
        k32 = _get_k32()
        h = k32.OpenProcess(0x0001, False, int(pid))
        if not h:
            raise ProcessLookupError(pid)
        try:
            if not k32.TerminateProcess(h, 1):
                raise ProcessLookupError(pid)
        finally:
            k32.CloseHandle(h)
    else:
        os.kill(pid, sig)


def kill_local_cc_safe_tree(exclude_account: str = None) -> dict:
    killed_pids = set()
    tracked = {}  # pid -> starttime，防止无环境变量孤儿子进程在父进程退出后逃逸二次 SIGKILL

    def _collect_and_signal(sig: int) -> list:
        live_targets = find_cc_safe_processes(exclude_account=exclude_account)
        for info in live_targets:
            tracked[info["pid"]] = info["starttime"]
        alive_now = []
        # 先向当前树叶子顺序发信号，再补发所有已登记但可能已被 PID 1 收养的存活进程
        ordered_pids = [p["pid"] for p in live_targets]
        seen_set = set(ordered_pids)
        for tpid, tst in list(tracked.items()):
            if tpid not in seen_set and _pid_matches_starttime(tpid, tst):
                ordered_pids.append(tpid)

        for pid in ordered_pids:
            tst = tracked.get(pid)
            if tst is not None and not _pid_matches_starttime(pid, tst):
                continue
            try:
                _kill_single_pid(pid, sig)
                killed_pids.add(pid)
                alive_now.append(pid)
            except ProcessLookupError:
                pass
            except Exception:
                pass
        return alive_now

    initial = _collect_and_signal(signal.SIGTERM)
    if initial:
        deadline = time.time() + 1.5
        while time.time() < deadline:
            time.sleep(0.1)
            if not _collect_and_signal(signal.SIGTERM):
                break

    _sig_force = getattr(signal, "SIGKILL", signal.SIGTERM)
    survivors = _collect_and_signal(_sig_force)
    if survivors:
        deadline = time.time() + 1.2
        while time.time() < deadline:
            time.sleep(0.1)
            if not _collect_and_signal(_sig_force):
                break

    rem_procs = {p["pid"]: p for p in find_cc_safe_processes(exclude_account=exclude_account)}
    for tpid, tst in tracked.items():
        if tpid not in rem_procs and _pid_matches_starttime(tpid, tst):
            rem_procs[tpid] = {"pid": tpid, "comm": "orphan", "argv": [f"pid:{tpid}"]}

    remaining = [
        {"pid": p["pid"], "comm": p["comm"], "cmd": " ".join(p.get("argv") or [])[:80]}
        for p in rem_procs.values()
    ]
    return {
        "killed": len(killed_pids),
        "killed_pids": sorted(killed_pids),
        "remaining": remaining,
    }


def kill_running_cc_safe_processes(peer_host: str = None, exclude_account: str = None) -> dict:
    local_res = kill_local_cc_safe_tree(exclude_account=exclude_account)
    remote_res = {"ok": True, "killed": 0, "killed_pids": [], "remaining": [], "error": ""}

    if peer_host:
        remote_cmd = "~/.local/bin/cc-switch kill-local"
        if exclude_account and ALIAS_RE.match(exclude_account):
            remote_cmd += f" --exclude {shlex.quote(exclude_account)}"
        try:
            res = subprocess.run(
                ["ssh", *SSH_BASE_OPTS, "--", peer_host, remote_cmd],
                capture_output=True,
                text=True,
                timeout=10,
            )
            if res.returncode == 0 and res.stdout.strip():
                parsed = json.loads(res.stdout.strip().splitlines()[-1])
                remote_res.update(
                    {
                        "ok": len(parsed.get("remaining", [])) == 0,
                        "killed": int(parsed.get("killed", 0)),
                        "killed_pids": parsed.get("killed_pids", []),
                        "remaining": parsed.get("remaining", []),
                    }
                )
            else:
                remote_res["ok"] = False
                remote_res["error"] = (res.stderr or res.stdout or f"exit={res.returncode}").strip()[:200]
        except Exception as e:
            remote_res["ok"] = False
            remote_res["error"] = str(e)

    return {"local": local_res, "remote": remote_res}


def sync_accounts_only_to_peer(peer_host: str, stop_peer_tunnel: bool = False, clear_peer_tunnel: bool = False) -> bool:
    if not peer_host or not os.path.exists(ACCOUNTS_FILE):
        return True
    try:
        peer_host = validate_peer_host(peer_host)
    except ValueError:
        return False
    nonce = f"{os.getpid()}_{secrets.token_hex(4)}"
    stage_rel = f".claude-safe/.stage_{nonce}"
    scp_host = _scp_target_host(peer_host)
    try:
        subprocess.run(
            [
                "ssh", *SSH_BASE_OPTS, "--", peer_host,
                f"umask 077 && mkdir -p ~/.claude-safe/config ~/.claude-safe/locks ~/{stage_rel} && chmod 700 ~/.claude-safe ~/.claude-safe/config ~/.claude-safe/locks ~/{stage_rel}",
            ],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=6,
        )
        files = [ACCOUNTS_FILE]
        if clear_peer_tunnel:
            for tf in (TUNNEL_JSON, TUNNEL_ENV):
                if os.path.exists(tf):
                    files.append(tf)
        subprocess.run(
            ["scp", "-q", *SSH_BASE_OPTS, *files, f"{scp_host}:~/{stage_rel}/"],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=6,
        )
        stop_snip = "~/.local/bin/cc-us-tunnel stop >/dev/null 2>&1 || true" if stop_peer_tunnel else "true"
        remote_cmd = f"""
set -e
umask 077
STAGE="$HOME/{stage_rel}"
trap 'rm -rf "$STAGE"' EXIT
(
  flock -w 10 9
  python3 - "$STAGE/accounts.json" "$HOME/.claude-safe/config/accounts.json" <<'PY'
import json, os, sys
src, dst = sys.argv[1], sys.argv[2]
incoming = json.load(open(src, "r", encoding="utf-8"))
if os.path.exists(dst):
    try:
        old = json.load(open(dst, "r", encoding="utf-8"))
        if isinstance(old, dict):
            merged_peers = dict(old.get("peers") or ())
            merged_peers.update(incoming.get("peers") or ())
            incoming["peers"] = merged_peers
            if old.get("win_proxy") and not incoming.get("expose_tailscale_proxy"):
                incoming.setdefault("win_proxy", old["win_proxy"])
    except Exception:
        pass
tmp = dst + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(incoming, f, indent=2, ensure_ascii=False)
os.replace(tmp, dst)
PY
  for tf in us-tunnel.json us-tunnel.env; do
    if [ -f "$STAGE/$tf" ]; then
      chmod 600 "$STAGE/$tf"
      mv "$STAGE/$tf" "$HOME/.claude-safe/config/$tf"
    fi
  done
  {stop_snip}
) 9>"$HOME/.claude-safe/locks/cc.lock"
"""
        r = subprocess.run(["ssh", *SSH_BASE_OPTS, "--", peer_host, remote_cmd], capture_output=True, text=True, timeout=14)
        return r.returncode == 0
    except Exception:
        subprocess.run(["ssh", *SSH_BASE_OPTS, "--", peer_host, f"rm -rf ~/{stage_rel}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return False


def sync_to_peer(acc_key: str, restart_tunnel: bool = False, quiet: bool = False, cred_only: bool = False) -> tuple:
    validate_alias_or_die(acc_key)
    data = load_accounts()
    peer_host = get_peer_host(data)
    if not peer_host:
        return True, "单机模式"
    paths = profile_paths(acc_key)
    ensure_profile_identity(acc_key)
    has_cred = os.path.exists(paths["cred"]) and os.path.getsize(paths["cred"]) > 20

    nonce = f"{os.getpid()}_{secrets.token_hex(4)}"
    stage_rel = f".claude-safe/.stage_{nonce}"
    scp_host = _scp_target_host(peer_host)

    try:
        subprocess.run(
            [
                "ssh",
                *SSH_BASE_OPTS,
                "--",
                peer_host,
                (
                    f"umask 077 && mkdir -p ~/.claude-safe/config ~/.claude-safe/locks ~/.claude-safe/logs "
                    f"~/.claude-safe/profiles/{acc_key}/home ~/{stage_rel} && "
                    f"chmod 700 ~/.claude-safe ~/.claude-safe/config ~/.claude-safe/locks ~/.claude-safe/logs "
                    f"~/.claude-safe/profiles ~/.claude-safe/profiles/{acc_key} ~/.claude-safe/profiles/{acc_key}/home ~/{stage_rel}"
                ),
            ],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=6,
        )
        files_to_copy = [paths["id_file"]]
        if not cred_only:
            for cfg_f in (ACCOUNTS_FILE, TUNNEL_JSON, TUNNEL_ENV):
                if os.path.exists(cfg_f):
                    files_to_copy.append(cfg_f)
        if has_cred:
            files_to_copy.append(paths["cred"])

        subprocess.run(
            ["scp", "-q", *SSH_BASE_OPTS, *files_to_copy, f"{scp_host}:~/{stage_rel}/"],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=8,
        )

        apply_snip = "" if cred_only else f"~/.local/bin/cc-switch apply-local {acc_key} --unlocked >/dev/null 2>&1 || true"
        tunnel_snip = ""
        if restart_tunnel:
            tunnel_snip = """
  ~/.local/bin/cc-us-tunnel restart >/dev/null 2>&1 || true
  TR_H="$(curl -s --noproxy "" -x http://127.0.0.1:7890 --max-time 6 https://api.anthropic.com/cdn-cgi/trace | tr -d '\\r' || true)"
  TR_S="$(curl -s --noproxy "" -x socks5h://127.0.0.1:7891 --max-time 6 https://api.anthropic.com/cdn-cgi/trace | tr -d '\\r' || true)"
  HTTP_IP="$(printf '%s\\n' "$TR_H" | grep '^ip=' | cut -d= -f2 || true)"
  HTTP_LOC="$(printf '%s\\n' "$TR_H" | grep '^loc=' | cut -d= -f2 || true)"
  SOCKS_IP="$(printf '%s\\n' "$TR_S" | grep '^ip=' | cut -d= -f2 || true)"
  SOCKS_LOC="$(printf '%s\\n' "$TR_S" | grep '^loc=' | cut -d= -f2 || true)"
  echo "${HTTP_IP}|${HTTP_LOC}|${SOCKS_IP}|${SOCKS_LOC}"
"""
        remote_cmd = f"""
set -e
umask 077
STAGE="$HOME/{stage_rel}"
trap 'rm -rf "$STAGE"' EXIT
(
  flock -w 12 9
  if [ -f "$STAGE/accounts.json" ]; then
    python3 - "$STAGE/accounts.json" "$HOME/.claude-safe/config/accounts.json" <<'PY'
import json, os, sys
src, dst = sys.argv[1], sys.argv[2]
inc = json.load(open(src, "r", encoding="utf-8"))
if os.path.exists(dst):
    try:
        old = json.load(open(dst, "r", encoding="utf-8"))
        if isinstance(old, dict):
            mp = dict(old.get("peers") or ())
            mp.update(inc.get("peers") or ())
            inc["peers"] = mp
    except Exception:
        pass
tmp = dst + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(inc, f, indent=2, ensure_ascii=False)
os.replace(tmp, dst)
PY
  fi
  for f in us-tunnel.json us-tunnel.env; do
    if [ -f "$STAGE/$f" ]; then
      chmod 600 "$STAGE/$f"
      mv "$STAGE/$f" "$HOME/.claude-safe/config/$f"
    fi
  done
  if [ -f "$STAGE/identity.json" ]; then
    python3 - "$STAGE/identity.json" "$HOME/.claude-safe/profiles/{acc_key}/identity.json" <<'PY'
import json, os, sys
src, dst = sys.argv[1], sys.argv[2]
inc = json.load(open(src, "r", encoding="utf-8"))
if os.path.exists(dst):
    try:
        old = json.load(open(dst, "r", encoding="utf-8"))
        if isinstance(old, dict):
            if not inc.get("oauthAccount") and old.get("oauthAccount"):
                inc["oauthAccount"] = old["oauthAccount"]
            if not inc.get("claudeCodeFirstTokenDate") and old.get("claudeCodeFirstTokenDate"):
                inc["claudeCodeFirstTokenDate"] = old["claudeCodeFirstTokenDate"]
    except Exception:
        pass
tmp = dst + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(inc, f, indent=2, ensure_ascii=False)
os.replace(tmp, dst)
PY
  fi
  if [ -f "$STAGE/.credentials.json" ]; then
    chmod 600 "$STAGE/.credentials.json"
    mv "$STAGE/.credentials.json" "$HOME/.claude-safe/profiles/{acc_key}/home/.credentials.json"
  fi
  {apply_snip}
  {tunnel_snip}
) 9>"$HOME/.claude-safe/locks/cc.lock"
rm -rf "$STAGE"
"""
        res = subprocess.run(
            ["ssh", *SSH_BASE_OPTS, "--", peer_host, remote_cmd],
            capture_output=True,
            text=True,
            timeout=22,
        )
        peer_ips = res.stdout.strip().splitlines()[-1] if (restart_tunnel and res.stdout.strip()) else ""
        return res.returncode == 0, peer_ips
    except Exception as e:
        subprocess.run(["ssh", *SSH_BASE_OPTS, "--", peer_host, f"rm -rf ~/{stage_rel}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if not quiet:
            print(f"⚠️  同步至对端 ({peer_host}) 失败: {e}")
        return False, ""


def print_help():
    print(
        """====================================================================================
🛡️  cc-switch — Claude Code 多账号物理硬隔离、一键换 IP 与美国家宽隧道管理器
====================================================================================
用法:
  cc-switch [status]                               查看所有账号状态、当前激活账号与 2FA 动态码
  cc-switch init                                   启动交互式快速配置向导 (新手录入 / 一键换 IP / 双机绑定)
  cc-switch <账号别名> [--force]                   清场双机进程 -> 切换美国家宽隧道 -> 双通道核验 -> 同步对端
  cc-switch add '<账号串>' [别名] [--force]        体检并添加新账号 (推荐 `cc-switch add -` 隐藏输入防历史留痕)
  cc-switch set-ip [别名] ['<新代理>'|-] [--force] 一键无损换 IP (自动体检+防复用+时区对齐，保留设备指纹与登录态！)
                                                   (同义别名: change-ip / rotate-ip / set-proxy / update-proxy)
  cc-switch check-ip [别名 | '<代理>' | -]         执行 5 维出口 IP 纯净度体检 (支持 `-` 隐藏输入)
  cc-switch kill                                   一键清零双机全部 cc-safe / MCP 残留子进程树
  cc-switch ban <别名> / unban <别名>              双机同步封禁熔断 (彻底锁死防 cron 复活) / 解除封禁
  cc-switch rm <别名> [--purge]                    移除指定账号配置 (--purge 同时清除其本地隔离目录)
  cc-switch set-peer <对端IP | off>                绑定双机同步对端主机 IP 或切回单机模式
  cc-switch win-proxy <on | off>                   开启/关闭 Tailscale 端口映射 (默认关闭，推荐 SSH -L 本地转发)
  cc-switch usage / reset                          查询实时 5h/7d 额度与 Reset 卡 / 一键使用 Reset 卡
  cc-switch import-session <关键词或UUID>          深度脱敏导入历史会话 (含 subagents 子会话与全域名邮箱脱敏)
  cc-switch doctor / audit                         运行 8 项生产运行态自检 / 15 维真实抓包防泄漏审计
  cc-switch pass [别名] / totp [别名] [--raw]      输出指定账号密码 / 6 位 2FA 动态验证码
===================================================================================="""
    )


def _format_login_browser_hint(acc_key: str, data: dict) -> str:
    if IS_WINDOWS:
        return f"直接运行 `cc-chrome {acc_key}` (一键打开同源美国 IP 隔离浏览器，远端 DNS + 禁 QUIC)"
    expose_ts = bool(data.get("expose_tailscale_proxy", False))
    win_proxy = data.get("win_proxy") or default_win_proxy(expose_ts)
    if expose_ts and win_proxy != "127.0.0.1:7890":
        return f'chrome --user-data-dir="%USERPROFILE%\\.claude-chrome\\{acc_key}" --proxy-server={win_proxy}'
    return (
        f"先在本机电脑运行 `ssh -N -L 7890:127.0.0.1:7890 <服务器>`，"
        f'再打开: chrome --user-data-dir="%USERPROFILE%\\.claude-chrome\\{acc_key}" --proxy-server=127.0.0.1:7890'
    )


def cmd_status():
    data = load_accounts()
    active_key = data.get("active", "")
    accounts = data.get("accounts", {})

    if active_key and active_key in accounts and ALIAS_RE.match(active_key):
        harvest_profile_oauth_meta(active_key, accounts[active_key].get("email", ""))

    print("====================================================================================")
    print("🛡️  cc-safe 多账号物理硬隔离与独立美国家宽管理器")
    print("   • cc-safe        -> ~/.claude-safe/profiles/<账号>/home (独立目录/指纹/专线熔断)")
    print("   • claude-sub2api -> ~/.claude                           (中转专用，零个人订阅凭证)")
    print("====================================================================================")
    topo_warn = check_topology_warning(data)
    if topo_warn:
        print(f"⚠️  [拓扑提示] {topo_warn}")
        print("------------------------------------------------------------------------------------")

    if not accounts:
        print("📭 当前尚未录入任何账号。快速开始：")
        print("   • 交互式向导 (推荐，密码不进历史) : cc-switch init")
        print("   • 或单行录入                      : cc-switch add - acc1")
    else:
        for k, v in accounts.items():
            if not isinstance(v, dict) or not ALIAS_RE.match(k):
                continue
            is_cur = k == active_key
            st = v.get("status", "active")
            paths = profile_paths(k)
            exp, _ = parse_valid_cred(open(paths["cred"], "r", encoding="utf-8").read()) if os.path.exists(paths["cred"]) else (0, None)
            if st == "banned":
                state_tag = "🚫 已封禁 (熔断锁死)"
            elif exp > 0:
                state_tag = "✅ 已登录 (切号/换IP免重登)"
            else:
                state_tag = "⏳ 待首次登录"
            prefix = "👉 [当前] " if is_cur else "          "
            print(f"{prefix}{k:<10} | {v.get('email',''):<28} | IP: {v.get('ip',''):<15} | {state_tag}")

    print("------------------------------------------------------------------------------------")
    if active_key and active_key in accounts and ALIAS_RE.match(active_key):
        cur = accounts[active_key]
        paths = profile_paths(active_key)
        id_data = ensure_profile_identity(active_key)
        totp_code, rem = gen_totp(cur.get("totp", ""))
        exp, _ = parse_valid_cred(open(paths["cred"], "r", encoding="utf-8").read()) if os.path.exists(paths["cred"]) else (0, None)
        st = cur.get("status", "active")
        peer_host = get_peer_host(data)
        hist_cnt = len(cur.get("ip_history") or [])
        print(f"📌 当前激活账号 : {active_key} ({cur.get('email', '')}) [{'🚫 BANNED' if st == 'banned' else '🟢 ACTIVE'}]")
        print(f"📁 专属隔离目录 : ~/.claude-safe/profiles/{active_key}/home")
        print(f"🌍 绑定美国家宽 : {cur.get('ip', '')} ({cur.get('loc', '')}) | 时区: {cur.get('tz', 'America/New_York')} (历史换IP: {hist_cnt} 次)")
        print(f"🖧  集群拓扑模式 : {f'双机同步 (对端 {peer_host})' if peer_host else '单机模式'}")
        print(f"🧬 专属设备指纹 : userID={id_data['userID'][:16]}... | machineID={id_data['machineID'][:16]}...")
        print(f"🔒 登录密码     : ****** (运行 `cc-switch pass` 查看) | 🔢 2FA: {totp_code} ({rem}s)")
        print(f"🔐 登录态状态   : {'✅ 已就绪 (直接运行 cc-safe)' if exp > 0 else '⏳ 未登录 (运行 cc-safe 后执行 /login)'}")
        print(f"🖥️  同源登录引导 : {_format_login_browser_hint(active_key, data)}")
        print("------------------------------------------------------------------------------------")
    print("💡 常用: cc-switch init | <账号> | set-ip (换IP) | add | kill | usage | reset | doctor | audit | --help")
    print("====================================================================================")


def cmd_kill():
    with global_lock(blocking=True):
        data = load_accounts()
        peer_host = get_peer_host(data)
        res = kill_running_cc_safe_processes(peer_host=peer_host)
        loc = res["local"]
        rem = res["remote"]
        print(
            f"🛑 [进程清场] 本机 ({HOSTNAME}) 已终止: {loc['killed']} 个进程 (残留: {len(loc['remaining'])})"
            + (
                f" | 对端 ({peer_host}) 已终止: {rem['killed']} 个进程 (残留: {len(rem['remaining'])})"
                if peer_host
                else ""
            )
        )
        failed = False
        if loc["remaining"]:
            print(f"❌ 本机仍有无法终止的残留进程: {loc['remaining']}")
            failed = True
        if peer_host and (not rem["ok"] or rem["remaining"]):
            print(f"❌ 对端 ({peer_host}) 清场异常或有残留: error={rem['error'] or '无'}, remaining={rem['remaining']}")
            failed = True
        if failed:
            sys.exit(1)
        print("✅ cc-safe / 个人订阅进程树已 100% 清零 (claude-sub2api 与其它普通代理任务不受影响)。")


def _resolve_account_alias(query: str, accounts: dict) -> str:
    q = (query or "").strip()
    if not q:
        print("❌ 账号名不能为空。请运行 `cc-switch status` 查看可用账号。", file=sys.stderr)
        sys.exit(1)
    if q in accounts:
        return q
    prefix_hits = [k for k, v in accounts.items() if isinstance(v, dict) and str(v.get("email") or "").lower().startswith(q.lower())]
    if len(prefix_hits) == 1:
        return prefix_hits[0]
    if len(prefix_hits) > 1:
        print(f"❌ 账号前缀 '{q}' 匹配到多个账号 {prefix_hits}，请指定明确的账号别名！", file=sys.stderr)
        sys.exit(1)
    avail = ", ".join(accounts.keys()) or "(暂无已录入账号，请先运行 cc-switch init 或 cc-switch add)"
    print(f"❌ 未找到账号 '{q}'。可用账号: {avail}", file=sys.stderr)
    sys.exit(1)


def cmd_switch(target_key: str, force: bool = False):
    with global_lock(blocking=True):
        data = load_accounts()
        accounts = data.get("accounts", {})
        target_key = _resolve_account_alias(target_key, accounts)
        validate_alias_or_die(target_key)

        acc = accounts[target_key]
        if acc.get("status") == "banned" and not force:
            print(f"🚫 拒绝切换：账号 [{target_key}] ({acc.get('email')}) 已标记为封禁 (banned)！")
            print("   严禁启用已封禁账号或其关联代理 IP。如需强制诊断请加 --force。")
            sys.exit(1)

        old_key = data.get("active", "")
        if old_key and old_key in accounts and ALIAS_RE.match(old_key):
            harvest_profile_oauth_meta(old_key, accounts[old_key].get("email", ""))

        peer_host = get_peer_host(data)
        kill_res = kill_running_cc_safe_processes(peer_host=peer_host)
        kl = kill_res["local"]["killed"]
        kr = kill_res["remote"]["killed"]
        loc_rem = kill_res["local"]["remaining"]
        rem_ok = kill_res["remote"]["ok"]
        rem_rem = kill_res["remote"]["remaining"]

        if kl > 0 or kr > 0:
            print(f"🛑 [进程树清场] 已终止残留的 cc-safe 进程及其子进程树 (本机: {kl}, 对端: {kr})。")
        else:
            print("✅ [进程树清场] 零残留旧会话进程。")

        if (loc_rem or (peer_host and (not rem_ok or rem_rem))) and not force:
            if loc_rem:
                print(f"❌ [Fail-Close 熔断] 本机存在无法终止的残留进程: {loc_rem}")
            if peer_host and (not rem_ok or rem_rem):
                print(
                    f"❌ [Fail-Close 熔断] 对端 ({peer_host}) 进程清场未确认完成 "
                    f"(error={kill_res['remote']['error'] or '无'}, remaining={rem_rem})！"
                )
            print("🛑 为防止残留进程携带旧 Token 借道新 IP 发包，已中止切号（确认忽略请加 --force）。")
            sys.exit(1)

        expected_ip = str(acc.get("ip") or "").strip()
        print(f"🔄 正在切换至账号 [{target_key}] ({acc.get('email','')}) -> 专属 IP: {expected_ip} ({acc.get('loc', '')})...")
        data["active"] = target_key
        save_accounts(data)
        write_tunnel_configs(acc, expose_tailscale=bool(data.get("expose_tailscale_proxy", False)))
        has_cred, _ = apply_profile_locally(target_key)

        subprocess.run(_py_cmd(CC_TUNNEL, "restart"), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        dyn_http, dyn_socks, _, _ = get_tunnel_proxy_urls()
        trace_http = probe_tunnel_trace(dyn_http, timeout=6)
        trace_socks = probe_tunnel_trace(dyn_socks, timeout=6)
        live_http_ip = trace_http.get("ip", "")
        live_http_loc = trace_http.get("loc", "")
        live_socks_ip = trace_socks.get("ip", "")
        live_socks_loc = trace_socks.get("loc", "")

        tunnel_failed = False
        if (
            expected_ip
            and live_http_ip == expected_ip
            and live_socks_ip == expected_ip
            and live_http_loc == "US"
            and live_socks_loc == "US"
        ):
            print(f"✅ 本机 ({HOSTNAME}) 双通道核验通过: HTTP & SOCKS5h 出口 IP = {live_http_ip} (US)")
        else:
            print(
                f"❌ [Fail-Close] 本机 ({HOSTNAME}) 隧道出口异常: "
                f"HTTP={live_http_ip or '超时'}({live_http_loc or '未知'}), "
                f"SOCKS5h={live_socks_ip or '超时'}({live_socks_loc or '未知'}), 预期={expected_ip}！"
            )
            tunnel_failed = True

        if peer_host:
            ok, peer_ips = sync_to_peer(target_key, restart_tunnel=True, quiet=False)
            p_http, p_hloc, p_socks, p_sloc = (peer_ips.split("|") + ["", "", "", ""])[:4] if peer_ips else ("", "", "", "")
            if ok and p_http == expected_ip and p_socks == expected_ip and p_hloc == "US" and p_sloc == "US":
                print(f"✅ 对端 ({peer_host}) 隔离档案与双通道隧道已同步 (出口 IP = {p_http}, US)！")
            else:
                print(
                    f"❌ [Fail-Close] 对端 ({peer_host}) 同步或隧道出口异常: "
                    f"sync_ok={ok}, HTTP={p_http or '超时'}({p_hloc or '?'}), SOCKS5h={p_socks or '超时'}({p_sloc or '?'}), 预期={expected_ip}！"
                )
                tunnel_failed = True

        # 二次兜底仅清理非 target_key 的越界旧会话，不误伤刚刚完成切换后新拉起的 target_key 会话
        post_kill = kill_running_cc_safe_processes(peer_host=peer_host, exclude_account=target_key)
        pkl, pkr = post_kill["local"]["killed"], post_kill["remote"]["killed"]
        if pkl > 0 or pkr > 0:
            print(f"🧹 [二次兜底清场] 已额外清理切号窗口并发残留的旧号进程 (本机: {pkl}, 对端: {pkr})。")

        if tunnel_failed and not force:
            print("🛑 隧道出口未通过严格一致性核验，请排查代理连通性或运行 `cc-switch set-ip` 更换代理（强制忽略请加 --force）。")
            sys.exit(1)

        print("------------------------------------------------------------------------------------")
        if old_key and old_key != target_key:
            print("⚠️  [浏览器防串号提醒] 若您电脑上仍开着旧账号的 Chrome 窗口，请先关闭后再打开新账号窗口！")
        if has_cred:
            print(f"🎉 账号 [{target_key}] 已就绪，直接运行 `cc-safe` (或 `claude`) 即可进入专属隔离空间！")
        else:
            totp_code, _ = gen_totp(acc.get("totp", ""))
            print(f"⏳ 账号 [{target_key}] 尚未登录，请执行首次同源登录：")
            print(f"   1. 打开同源代理 Chrome: {_format_login_browser_hint(target_key, data)}")
            print("   2. 终端运行 `cc-safe` 并输入 `/login`")
            print(f"   3. 邮箱: {acc.get('email','')} | 密码: `cc-switch pass` | 2FA: {totp_code} (`cc-totp`)")
            print("   4. 登录成功后自动归档同步（也可手动运行 `cc-switch sync`）")


def cmd_sync(target_acc: str = None, quiet: bool = False, cred_only: bool = False):
    with global_lock(blocking=True):
        data = load_accounts()
        active_key = target_acc if (target_acc and target_acc in data.get("accounts", {})) else data.get("active", "")
        if not active_key or active_key not in data.get("accounts", {}):
            if not quiet:
                print("❌ 当前无有效激活账号。")
            sys.exit(1)
        acc = data["accounts"][active_key]
        harvest_profile_oauth_meta(active_key, acc.get("email", ""))
        if not cred_only and active_key == data.get("active"):
            write_tunnel_configs(acc, expose_tailscale=bool(data.get("expose_tailscale_proxy", False)))
            has_cred, _ = apply_profile_locally(active_key, if_idle=True)
        else:
            paths = profile_paths(active_key)
            exp, _ = parse_valid_cred(open(paths["cred"], "r", encoding="utf-8").read()) if os.path.exists(paths["cred"]) else (0, None)
            has_cred = exp > 0
        ok, _ = sync_to_peer(active_key, restart_tunnel=False, quiet=quiet, cred_only=cred_only)
        if not quiet:
            print(f"✅ 账号 [{active_key}] 档案与凭证已同步 ({'含有效登录态' if has_cred else '仅配置，待登录'} | 对端同步: {'成功' if ok else '失败'})。")


def cmd_auto_sync():
    """定时任务无死锁自愈同步：错峰 + 远端非阻塞 flock -n + 运行中会话保护 + identity.json 协同归档。"""
    # 基于主机名哈希错峰 0~4 秒，彻底避免双机 cron 在整分同时互锁 (AB-BA 死锁)
    jitter = (int(hashlib.sha256(HOSTNAME.encode()).hexdigest()[:4], 16) % 40) / 10.0
    if jitter > 0 and os.environ.get("CC_AUDIT_SANDBOX") != "1":
        time.sleep(jitter)

    with global_lock(blocking=False) as acquired:
        if not acquired:
            return
        data = load_accounts()
        active_key = data.get("active", "")
        if not active_key or active_key not in data.get("accounts", {}) or not ALIAS_RE.match(active_key):
            return
        acc = data["accounts"][active_key]
        if acc.get("status") == "banned":
            return

        paths = profile_paths(active_key)
        id_data = harvest_profile_oauth_meta(active_key, acc.get("email", ""))
        local_cred = paths["cred"]
        local_exp, local_raw = (
            parse_valid_cred(open(local_cred, "r", encoding="utf-8").read()) if os.path.exists(local_cred) else (0, None)
        )

        peer_host = get_peer_host(data)
        if not peer_host:
            return

        peer_rel_dir = f"~/.claude-safe/profiles/{active_key}"
        try:
            probe_py = (
                f"python3 -c 'import json,os; p=os.path.expanduser(\"{peer_rel_dir}\"); "
                "af=os.path.expanduser(\"~/.claude-safe/config/accounts.json\"); "
                "ak=json.load(open(af)).get(\"active\",\"\") if os.path.exists(af) else \"\"; "
                "cr=open(p+\"/home/.credentials.json\").read() if os.path.exists(p+\"/home/.credentials.json\") else \"\"; "
                "idd=json.load(open(p+\"/identity.json\")) if os.path.exists(p+\"/identity.json\") else {}; "
                "print(json.dumps({\"active\":ak,\"cred\":cr,\"oa\":idd.get(\"oauthAccount\"),\"ftd\":idd.get(\"claudeCodeFirstTokenDate\")}))'"
            )
            res = subprocess.run(
                ["ssh", *SSH_BASE_OPTS, "--", peer_host, probe_py],
                capture_output=True,
                text=True,
                timeout=6,
            )
            if res.returncode != 0 or not res.stdout.strip():
                return
            peer_state = json.loads(res.stdout.strip().splitlines()[-1])
        except Exception:
            return

        # 若对端 active 账号不一致，不做跨号覆盖
        if peer_state.get("active") and peer_state.get("active") != active_key:
            return

        peer_exp, peer_raw = parse_valid_cred(peer_state.get("cred") or "")

        # 合并 oauthAccount 元数据 (绝不用空覆盖非空)
        id_changed = False
        if not id_data.get("oauthAccount") and isinstance(peer_state.get("oa"), dict):
            id_data["oauthAccount"] = peer_state["oa"]
            id_changed = True
        if not id_data.get("claudeCodeFirstTokenDate") and peer_state.get("ftd"):
            id_data["claudeCodeFirstTokenDate"] = peer_state["ftd"]
            id_changed = True
        if id_changed:
            atomic_write_json(paths["id_file"], id_data, 0o600)

        best_exp, best_raw = (local_exp, local_raw) if local_exp >= peer_exp else (peer_exp, peer_raw)
        if best_exp <= 0 or not best_raw:
            return

        # 仅当本机当前无正在运行的该账号会话时才回写更新本机 .credentials.json，避免与运行中 OAuth 刷新竞争
        if local_exp < best_exp and not _has_live_session_for_account(active_key):
            atomic_write_text(local_cred, best_raw, 0o600)

        if peer_exp < best_exp or (id_data.get("oauthAccount") and not peer_state.get("oa")):
            payload_json = json.dumps(
                {
                    "cred": best_raw if peer_exp < best_exp else None,
                    "oa": id_data.get("oauthAccount"),
                    "ftd": id_data.get("claudeCodeFirstTokenDate"),
                },
                ensure_ascii=False,
            )
            write_cmd = f"""
umask 077
mkdir -p ~/.claude-safe/locks {peer_rel_dir}/home
(
  flock -n 9 || exit 0
  python3 - "{active_key}" <<'PY'
import json, os, sys
ak = sys.argv[1]
payload = json.loads(sys.stdin.read())
pdir = os.path.expanduser(f"~/.claude-safe/profiles/{{ak}}")
cred_p = os.path.join(pdir, "home", ".credentials.json")
id_p = os.path.join(pdir, "identity.json")
if payload.get("cred"):
    tmp = cred_p + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(payload["cred"])
    os.replace(tmp, cred_p)
if os.path.exists(id_p) and (payload.get("oa") or payload.get("ftd")):
    idd = json.load(open(id_p, "r", encoding="utf-8"))
    ch = False
    if payload.get("oa") and not idd.get("oauthAccount"):
        idd["oauthAccount"] = payload["oa"]; ch = True
    if payload.get("ftd") and not idd.get("claudeCodeFirstTokenDate"):
        idd["claudeCodeFirstTokenDate"] = payload["ftd"]; ch = True
    if ch:
        tmp2 = id_p + ".tmp"
        fd2 = os.open(tmp2, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd2, "w", encoding="utf-8") as f2:
            json.dump(idd, f2, indent=2, ensure_ascii=False)
        os.replace(tmp2, id_p)
PY
) 9>~/.claude-safe/locks/cc.lock
"""
            try:
                subprocess.run(
                    ["ssh", *SSH_BASE_OPTS, "--", peer_host, write_cmd],
                    input=payload_json,
                    text=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=6,
                )
            except Exception:
                pass


def _encode_proxy_part(raw: str) -> str:
    tokens = re.split(r"(%[0-9A-Fa-f]{2})", raw)
    out = []
    for tok in tokens:
        if re.fullmatch(r"%[0-9A-Fa-f]{2}", tok):
            out.append(tok)
        else:
            out.append(quote(tok, safe=""))
    return "".join(out)


def _extract_proxy_user_base(proxy_url: str) -> str:
    try:
        s = (proxy_url or "").strip()
        rest = s.split("://", 1)[1] if "://" in s else s
        rest = rest.split("/", 1)[0]
        if "@" not in rest:
            return ""
        userinfo = rest.rpartition("@")[0]
        u = unquote(userinfo.split(":", 1)[0])
        return u.split("-ip-")[0] if "-ip-" in u else u
    except Exception:
        return ""


def _parse_proxy_input(proxy_raw: str) -> tuple:
    s = (proxy_raw or "").strip()
    if not s or any(c in s for c in "\r\n\x00"):
        print("❌ 代理段为空或包含非法控制字符！", file=sys.stderr)
        sys.exit(1)

    try:
        def _looks_like_hostport(cand: str) -> bool:
            c = cand.strip()
            if c.startswith("["):
                rb_c = c.find("]")
                return rb_c != -1 and rb_c + 2 < len(c) and c[rb_c + 1] == ":" and c[rb_c + 2 :].isdigit() and 1 <= int(c[rb_c + 2 :]) <= 65535
            if c.count(":") == 1:
                hc, pc = c.rsplit(":", 1)
                return bool(hc) and not any(ch in hc for ch in " \t\r\n/@#[]") and pc.isdigit() and 1 <= int(pc) <= 65535
            return False

        if "://" in s:
            scheme, rest = s.split("://", 1)
            scheme = scheme.lower().strip()
            if scheme not in ("http", "https", "socks5", "socks5h"):
                raise ValueError(f"不支持的代理协议 '{scheme}' (仅支持 http/https/socks5/socks5h)")
            rest = rest.split("/", 1)[0]
            if "@" in rest:
                userinfo, hostport = rest.rpartition("@")[0], rest.rpartition("@")[2]
                puser, ppass = (userinfo.split(":", 1) if ":" in userinfo else (userinfo, ""))
                auth_part = f"{_encode_proxy_part(puser)}:{_encode_proxy_part(ppass)}@"
            else:
                hostport, auth_part = rest, ""
        elif s.startswith("["):
            scheme = "http"
            rb = s.find("]")
            if rb == -1 or rb + 2 > len(s) or s[rb + 1] != ":":
                raise ValueError("IPv6 代理格式错误，应为 [ipv6]:port:user:pass 或 http://user:pass@[ipv6]:port")
            host_only = s[1:rb]
            tail = s[rb + 2 :].split(":")
            if len(tail) == 1:
                hostport, auth_part = f"[{host_only}]:{tail[0]}", ""
            elif len(tail) >= 3:
                port_s, puser, ppass = tail[0], tail[1], ":".join(tail[2:])
                hostport = f"[{host_only}]:{port_s}"
                auth_part = f"{quote(puser, safe='')}:{quote(ppass, safe='')}@"
            else:
                raise ValueError("IPv6 代理段应为 [ipv6]:port:user:pass")
        elif (
            "@" in s
            and _looks_like_hostport(s.rpartition("@")[2])
            and not (len(s.split(":")) >= 4 and "@" not in s.split(":")[0] and s.split(":")[1].isdigit() and s.rpartition("@")[0].count(":") >= 2)
        ):
            userinfo, hostport = s.rpartition("@")[0], s.rpartition("@")[2]
            puser, ppass = (userinfo.split(":", 1) if ":" in userinfo else (userinfo, ""))
            scheme = "http"
            auth_part = f"{_encode_proxy_part(puser)}:{_encode_proxy_part(ppass)}@"
        else:
            scheme = "http"
            p_parts = s.split(":")
            if len(p_parts) == 2:
                hostport, auth_part = f"{p_parts[0].strip()}:{p_parts[1].strip()}", ""
            elif len(p_parts) >= 4:
                host_s, port_s, puser, ppass = p_parts[0].strip(), p_parts[1].strip(), p_parts[2], ":".join(p_parts[3:])
                hostport = f"{host_s}:{port_s}"
                auth_part = f"{quote(puser, safe='')}:{quote(ppass, safe='')}@"
            else:
                raise ValueError("应为 host:port:user:pass 或 http://user:pass@host:port")

        hp = hostport.strip()
        if hp.startswith("["):
            rb = hp.find("]")
            if rb == -1 or rb + 2 > len(hp) or hp[rb + 1] != ":":
                raise ValueError("IPv6 地址缺少闭合 ] 或端口")
            host = hp[1:rb]
            port_s = hp[rb + 2 :]
            ipaddress.ip_address(host)
        elif hp.count(":") > 1:
            h_cand, p_cand = hp.rsplit(":", 1)
            ipaddress.ip_address(h_cand)
            host, port_s = h_cand, p_cand
        elif hp.count(":") == 1:
            host, port_s = hp.rsplit(":", 1)
        else:
            raise ValueError("缺少代理端口")

        if not port_s.isdigit() or not (1 <= int(port_s) <= 65535):
            raise ValueError(f"端口非法 '{port_s}'")
        if not host or any(c in host for c in " \t\r\n/@#"):
            raise ValueError(f"主机名非法 '{host}'")

        disp_hp = f"[{host}]:{port_s}" if ":" in host else f"{host}:{port_s}"
        return f"{scheme}://{auth_part}{disp_hp}", disp_hp
    except ValueError as e:
        print(f"❌ 代理格式错误: {e}", file=sys.stderr)
        sys.exit(1)


def _check_ip_collisions(new_ip: str, new_proxy_url: str, self_alias: str, data: dict, force: bool):
    ip_octets = new_ip.split(".")
    new_u_base = _extract_proxy_user_base(new_proxy_url)
    for k, old in (data.get("accounts") or {}).items():
        if not isinstance(old, dict):
            continue
        old_ip = str(old.get("ip") or "").strip()
        old_st = old.get("status", "active")
        # 1. 检查其它账号当前在用 IP
        if k != self_alias:
            if old_ip == new_ip:
                print(f"🚫 [防关联拦截] 代理出口 IP ({new_ip}) 与已有账号 [{k}] ({old_st}) 完全相同！严禁多号共用同 IP！")
                sys.exit(1)
            old_octets = old_ip.split(".")
            if len(ip_octets) == 4 and len(old_octets) == 4:
                if ip_octets[:3] == old_octets[:3] and not force:
                    print(f"🚫 [防关联拦截] 新 IP ({new_ip}) 与账号 [{k}] ({old_ip}, {old_st}) 处于同一 /24 子网！已拦截（忽略请加 --force）。")
                    sys.exit(1)
                if ip_octets[:2] == old_octets[:2] and old_st == "banned" and not force:
                    print(f"🚫 [防关联拦截] 新 IP ({new_ip}) 与已封禁账号 [{k}] ({old_ip}) 处于同一 /16 ISP 号段 ({ip_octets[0]}.{ip_octets[1]}.*.*)！")
                    print("   同 /16 静态 ISP 段易触发关联风控，建议更换其它州/ASN 住宅代理（忽略请加 --force）。")
                    sys.exit(1)
            old_u_base = _extract_proxy_user_base(old.get("proxy", ""))
            if new_u_base and new_u_base == old_u_base and old_st == "banned":
                print(f"⚠️  [提示] 新代理与已封禁账号 [{k}] 共享代理商子账户 ({new_u_base})，但出口 IP 不同 ({new_ip} vs {old_ip})。")

        # 2. 检查所有账号曾经退役/污染过的历史 IP (ip_history)
        for hist in old.get("ip_history") or []:
            if isinstance(hist, dict) and hist.get("ip") == new_ip and not force:
                print(
                    f"🚫 [废弃 IP 防复用拦截] 该 IP ({new_ip}) 曾于 {hist.get('retired_at','历史记录')} 被账号 [{k}] 停用淘汰！"
                    "\n   严禁二次回用淘汰 IP（如确认恢复原代理请加 --force）。"
                )
                sys.exit(1)


def _probe_and_audit_new_proxy(proxy_url: str, host_port: str, label_tag: str, force: bool) -> tuple:
    print(f"🔍 正在检测 [{label_tag}] 的美国家宽代理 ({host_port})...")
    trace = probe_tunnel_trace(proxy_url, timeout=8)
    ip = trace.get("ip", "").strip()
    loc_cc = trace.get("loc", "").strip()
    if not ip or loc_cc != "US":
        print(f"❌ 代理不可用或非美国出口 (ip={ip or '连接失败'}, loc={loc_cc or '未知'})！拒绝启用。")
        sys.exit(1)
    try:
        ip = str(ipaddress.ip_address(ip))
    except ValueError:
        print(f"❌ 代理返回了非法出口 IP: '{ip}'")
        sys.exit(1)

    info_out = safe_curl("https://ipinfo.io/json", proxy_url=proxy_url, timeout=8)
    try:
        info = json.loads(info_out) if info_out.strip() else {}
    except Exception:
        info = {}
    city = info.get("city", "")
    region = info.get("region", "")
    org = info.get("org", "")
    tz = str(info.get("timezone") or "").strip() or "America/New_York"
    loc = f"{city}, {region} ({org})".strip(", ()") or "US"

    if os.path.exists(CC_CHECK_IP):
        chk_env = dict(os.environ)
        chk_env["CC_CHECK_PROXY_URL"] = proxy_url
        chk = subprocess.run(_py_cmd(CC_CHECK_IP), env=chk_env)
        if chk.returncode != 0 and not force:
            print("🛑 新代理未通过 5 维 IP 纯净度准入体检，已中止操作（如确认强制启用请加 --force）。")
            sys.exit(1)

    return ip, loc, tz


def cmd_add(raw_str: str, alias: str = None, force: bool = False):
    if raw_str == "-":
        if sys.stdin.isatty():
            print("🔐 安全录入模式 (输入内容不会写入 ~/.bash_history 或 ps aux):")
            email = input("  1. Claude 邮箱: ").strip()
            passwd = getpass.getpass("  2. 登录密码 (隐藏回显): ")
            totp = getpass.getpass("  3. 2FA TOTP 密钥 (无则直接回车): ").strip()
            proxy_raw = getpass.getpass("  4. 专属美国家宽代理 (host:port:user:pass 或 http://user:pass@host:port): ").strip()
            if not alias:
                alias_in = input("  5. 账号短别名 (回车自动生成): ").strip()
                if alias_in:
                    alias = alias_in
            sid = ""
        else:
            raw_line = sys.stdin.readline().rstrip("\r\n")
            raw_str = raw_line

    if raw_str != "-":
        parts = raw_str.strip().split("----")
        if len(parts) == 4:
            email, passwd, totp, proxy_raw = parts[0].strip(), parts[1], parts[2].strip(), parts[3].strip()
            sid = ""
        elif len(parts) >= 5:
            email, passwd, totp, sid, proxy_raw = (
                parts[0].strip(),
                parts[1],
                parts[2].strip(),
                parts[3].strip(),
                "----".join(parts[4:]).strip(),
            )
        else:
            print("❌ 格式错误！支持 `cc-switch add -` 交互安全输入，或 5 段 (`邮箱----密码----TOTP----sid----代理`) / 4 段格式。")
            sys.exit(1)

    if not email or "@" not in email:
        print("❌ 请输入有效的账号邮箱地址！", file=sys.stderr)
        sys.exit(1)

    proxy_url, host_port = _parse_proxy_input(proxy_raw)
    explicit_alias = bool(alias)

    with global_lock(blocking=True):
        data_pre = load_accounts()
        existing_accs = data_pre.get("accounts", {})

        # 防止用户本想给已有账号「换 IP」，却误执行 `add` 导致同一邮箱分裂出第二个新指纹账号！
        for ek, ev in existing_accs.items():
            if isinstance(ev, dict) and str(ev.get("email") or "").lower() == email.lower():
                if not explicit_alias or alias != ek:
                    print(f"💡 检测到邮箱 {email} 已存在于账号 [{ek}]！")
                    print(f"   • 如需为该账号【更换代理 IP】(保留原设备指纹与登录态免重登)，请运行:")
                    print(f"     cc-switch set-ip {ek} -")
                    print(f"   • 如确需覆盖更新 [{ek}] 的密码/2FA 与代理，请显式指定原别名并加 --force。")
                    sys.exit(1)

        if not alias:
            base_alias = re.sub(r"[^a-zA-Z0-9]", "", email.split("@")[0])[:12].lower() or "acc1"
            if not base_alias[0].isalnum() or base_alias in RESERVED_VERBS:
                base_alias = f"acc_{base_alias}"[:16]
            cand = base_alias
            idx = 2
            # 若同名别名已被「不同邮箱」占用，自动递增后缀防覆盖串号！
            while cand in existing_accs and str(existing_accs[cand].get("email") or "").lower() != email.lower():
                cand = f"{base_alias}{idx}"
                idx += 1
            alias = cand
        else:
            validate_alias_or_die(alias)
            if alias in existing_accs and str(existing_accs[alias].get("email") or "").lower() != email.lower() and not force:
                print(
                    f"🚫 别名 [{alias}] 已被另一邮箱 ({existing_accs[alias].get('email')}) 占用！"
                    "\n   严禁跨账号覆盖同一隔离目录（否则会导致旧 OAuth Token 在新 IP 上裸奔），请换用新别名。"
                )
                sys.exit(1)

    validate_alias_or_die(alias)
    ip, loc, tz = _probe_and_audit_new_proxy(proxy_url, host_port, f"{alias} ({email})", force=force)

    with global_lock(blocking=True):
        data = load_accounts()
        _check_ip_collisions(ip, proxy_url, alias, data, force=force)
        prev_hist = (data.get("accounts", {}).get(alias) or {}).get("ip_history") or []
        data["accounts"][alias] = {
            "id": alias,
            "label": f"{alias} ({email})",
            "status": "active",
            "email": email,
            "pass": passwd,
            "totp": totp,
            "sid": sid,
            "proxy": proxy_url,
            "ip": ip,
            "loc": loc,
            "tz": tz,
            "ip_history": prev_hist,
        }
        save_accounts(data)
        ensure_profile_identity(alias)

    print(f"✅ 已录入新账号 [{alias}]: IP={ip} | 属地={loc} | 时区={tz}")
    cmd_switch(alias, force=force)


def cmd_set_ip(target_key: str = None, proxy_raw: str = None, force: bool = False):
    """
    一键无损更换已有账号的静态住宅代理 IP (`换IP`):
    - 100% 保留该账号原有的 6 维设备指纹 (identity.json) 与已登录 OAuth 凭证 (.credentials.json)，免重新登录！
    - 自动完成新代理 5 维纯净度体检、跨号网段防撞车与历史废弃 IP 防回用拦截；
    - 自动根据新 IP 属地对齐 TZ 时区，防止 IP 属地与系统时区穿帮；
    - 若目标账号当前处于激活状态，先清场双机旧会话进程再热切 Gost 专线并做双通道 (HTTP+SOCKS5h) 核验。
    """
    data_init = load_accounts()
    accounts_init = data_init.get("accounts", {})
    if not accounts_init:
        print("❌ 当前尚未录入任何账号，请先运行 `cc-switch init` 或 `cc-switch add -` 添加账号。", file=sys.stderr)
        sys.exit(1)

    # 智能参数识别：支持 `cc-switch set-ip` (全交互)、`cc-switch set-ip <新代理|-|acc|email>`、`cc-switch set-ip <acc|email> <新代理|->`
    if target_key and not proxy_raw:
        matched_existing = None
        if target_key in accounts_init:
            matched_existing = target_key
        else:
            tl = target_key.strip().lower()
            for ek, ev in accounts_init.items():
                if isinstance(ev, dict) and str(ev.get("email") or "").strip().lower() == tl:
                    matched_existing = ek
                    break
        if matched_existing:
            target_key = matched_existing
        elif target_key == "-" or "://" in target_key or ":" in target_key:
            proxy_raw = target_key
            target_key = data_init.get("active", "")
            if not target_key:
                print("❌ 当前无激活账号，请显式指定账号别名: cc-switch set-ip <账号别名> -", file=sys.stderr)
                sys.exit(1)

    if not target_key:
        if not sys.stdin.isatty():
            print("用法: cc-switch set-ip <账号别名> '<新代理>' [--force]", file=sys.stderr)
            sys.exit(1)
        print("📋 当前已录入账号列表:")
        keys = [k for k in accounts_init.keys() if ALIAS_RE.match(k)]
        for idx, k in enumerate(keys, 1):
            av = accounts_init[k]
            cur_mark = " (当前激活)" if k == data_init.get("active") else ""
            print(f"   [{idx}] {k:<10} | {av.get('email',''):<26} | 当前 IP: {av.get('ip','')} ({av.get('status','active')}){cur_mark}")
        default_k = data_init.get("active") or keys[0]
        sel = input(f"👉 请输入要换 IP 的账号别名或序号 [默认 {default_k}]: ").strip()
        if not sel:
            target_key = default_k
        elif sel.isdigit() and 1 <= int(sel) <= len(keys):
            target_key = keys[int(sel) - 1]
        else:
            target_key = sel

    target_key = _resolve_account_alias(target_key, accounts_init)
    validate_alias_or_die(target_key)
    old_acc = accounts_init[target_key]
    if old_acc.get("status") == "banned" and not force:
        print(
            f"🚫 账号 [{target_key}] 当前处于封禁熔断状态 (banned)，拒绝为其更换或启用新代理！"
            f"\n   如已确认官方申诉解封，请先运行 `cc-switch unban {target_key}`（或加 --force 仅离线预绑定代理）。",
            file=sys.stderr,
        )
        sys.exit(1)

    if not proxy_raw or proxy_raw == "-":
        if sys.stdin.isatty():
            proxy_raw = getpass.getpass(
                f"🔐 请输入账号 [{target_key}] 的新美国家宽代理 (host:port:user:pass 或 http://user:pass@host:port，隐藏回显): "
            ).strip()
        else:
            proxy_raw = sys.stdin.readline().strip()

    proxy_url, host_port = _parse_proxy_input(proxy_raw)
    old_ip = str(old_acc.get("ip") or "").strip()
    old_tz = str(old_acc.get("tz") or "America/New_York").strip()

    new_ip, new_loc, new_tz = _probe_and_audit_new_proxy(
        proxy_url, host_port, f"换IP -> {target_key} ({old_acc.get('email','')})", force=force
    )

    if new_ip == old_ip and proxy_url == old_acc.get("proxy") and not force:
        print(f"ℹ️  新代理出口 IP ({new_ip}) 与账号 [{target_key}] 当前绑定 IP 完全一致，无需变更。")
        return

    with global_lock(blocking=True):
        data = load_accounts()
        if target_key not in data.get("accounts", {}):
            print(f"❌ 未找到账号 '{target_key}'", file=sys.stderr)
            sys.exit(1)
        if data["accounts"][target_key].get("status") == "banned" and not force:
            print(f"🚫 账号 [{target_key}] 已处于 banned 状态，已中止换 IP！", file=sys.stderr)
            sys.exit(1)
        if new_ip != old_ip:
            _check_ip_collisions(new_ip, proxy_url, target_key, data, force=force)

        acc = data["accounts"][target_key]
        is_active = data.get("active") == target_key and acc.get("status") != "banned"
        peer_host = get_peer_host(data)

        # 若当前正激活该账号，换 IP 前必须先清零本机与对端全部活跃会话，严防同一 TCP/会话中途瞬移 IP！
        if is_active:
            harvest_profile_oauth_meta(target_key, acc.get("email", ""))
            kill_res = kill_running_cc_safe_processes(peer_host=peer_host)
            kl, kr = kill_res["local"]["killed"], kill_res["remote"]["killed"]
            loc_rem, rem_ok, rem_rem = kill_res["local"]["remaining"], kill_res["remote"]["ok"], kill_res["remote"]["remaining"]
            if kl > 0 or kr > 0:
                print(f"🛑 [换 IP 前清场] 已安全终止正在运行的会话进程 (本机: {kl}, 对端: {kr})，防止长连接瞬移触发风控。")
                if old_tz != new_tz:
                    print(f"⚠️  [跨时区瞬移提示] 旧 IP 时区 ({old_tz}) -> 新 IP 时区 ({new_tz})，建议静置 15~30 分钟后再发起高频请求。")
            if (loc_rem or (peer_host and (not rem_ok or rem_rem))) and not force:
                print(f"❌ [Fail-Close 熔断] 换 IP 前清场未确认完成 (local={loc_rem}, remote_err={kill_res['remote']['error']})，已中止！")
                sys.exit(1)

        if old_ip and old_ip != new_ip:
            hist = list(acc.get("ip_history") or [])
            hist.append(
                {
                    "ip": old_ip,
                    "loc": acc.get("loc", ""),
                    "tz": old_tz,
                    "retired_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                }
            )
            acc["ip_history"] = hist[-20:]

        acc["proxy"] = proxy_url
        acc["ip"] = new_ip
        acc["loc"] = new_loc
        acc["tz"] = new_tz
        now_str = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        acc["ip_updated_at"] = now_str
        save_accounts(data)

        has_cred, id_data = apply_profile_locally(target_key)

        if is_active:
            write_tunnel_configs(acc, expose_tailscale=bool(data.get("expose_tailscale_proxy", False)))
            subprocess.run(_py_cmd(CC_TUNNEL, "restart"), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            dyn_http, dyn_socks, _, _ = get_tunnel_proxy_urls()
            tr_h = probe_tunnel_trace(dyn_http, timeout=6)
            tr_s = probe_tunnel_trace(dyn_socks, timeout=6)
            tunnel_bad = not (
                tr_h.get("ip") == new_ip
                and tr_s.get("ip") == new_ip
                and tr_h.get("loc") == "US"
                and tr_s.get("loc") == "US"
            )
            if not tunnel_bad:
                print(f"✅ 本机 ({HOSTNAME}) 专线热切核验通过: HTTP & SOCKS5h = {new_ip} (US)")
            else:
                print(
                    f"❌ [Fail-Close] 本机新隧道核验失败: HTTP={tr_h.get('ip')}({tr_h.get('loc')}), "
                    f"SOCKS5h={tr_s.get('ip')}({tr_s.get('loc')}), 预期={new_ip}"
                )

            if peer_host:
                ok, peer_ips = sync_to_peer(target_key, restart_tunnel=True, quiet=False)
                p_http, p_hloc, p_socks, p_sloc = (peer_ips.split("|") + ["", "", "", ""])[:4] if peer_ips else ("", "", "", "")
                if ok and p_http == new_ip and p_socks == new_ip and p_hloc == "US" and p_sloc == "US":
                    print(f"✅ 对端 ({peer_host}) 新专线与配置同步核验通过 (出口 IP = {p_http}, US)！")
                else:
                    print(f"❌ [Fail-Close] 对端 ({peer_host}) 新隧道核验异常: sync={ok}, raw={peer_ips}")
                    tunnel_bad = True

            if tunnel_bad and not force:
                sys.exit(1)
        else:
            if peer_host:
                sync_to_peer(target_key, restart_tunnel=False, quiet=False)

    print("====================================================================================")
    print(f"🎉 账号 [{target_key}] 换 IP 完成！")
    print(f"   • 旧出口 IP : {old_ip or '无'} ({old_tz})  ->  新出口 IP: {new_ip} ({new_loc} | {new_tz})")
    print(f"   • 设备指纹  : 已无损保留 (userID={id_data['userID'][:16]}...)")
    print(f"   • 登录凭证  : {'✅ 已无损保留 (免重登，直接运行 cc-safe)' if has_cred else '⏳ 待首次登录 (`cc-safe` -> `/login`)'}")
    if not is_active:
        print(f"   • 激活提示  : 当前激活账号仍为 [{data.get('active') or '无'}]，运行 `cc-switch {target_key}` 即可启用。")
    print("====================================================================================")


def cmd_remove(target_key: str, purge_files: bool = False):
    with global_lock(blocking=True):
        data = load_accounts()
        accounts = data.get("accounts", {})
        target_key = _resolve_account_alias(target_key, accounts)
        validate_alias_or_die(target_key)
        is_active = data.get("active") == target_key
        peer_host = get_peer_host(data)
        if is_active:
            kill_running_cc_safe_processes(peer_host=peer_host)
            write_tunnel_configs({}, expose_tailscale=False)
            subprocess.run(_py_cmd(CC_TUNNEL, "stop"), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            data["active"] = ""
        accounts.pop(target_key, None)
        save_accounts(data)
        if purge_files:
            pdir = os.path.join(PROFILES_DIR, target_key)
            if os.path.isdir(pdir) and not os.path.islink(pdir):
                shutil.rmtree(pdir, ignore_errors=True)
        sync_accounts_only_to_peer(peer_host, stop_peer_tunnel=is_active, clear_peer_tunnel=is_active)
    print(f"✅ 已移除账号 [{target_key}]" + (" 并清理其本地隔离档案目录。" if purge_files else "（本地历史目录保留于 ~/.claude-safe/profiles，彻底删除可加 --purge）。"))


def cmd_win_proxy(mode: str):
    m = (mode or "").strip().lower()
    if m not in ("on", "off", "enable", "disable", "true", "false"):
        print("用法: cc-switch win-proxy <on | off>", file=sys.stderr)
        sys.exit(1)
    enable = m in ("on", "enable", "true")
    with global_lock(blocking=True):
        data = load_accounts()
        data["expose_tailscale_proxy"] = enable
        data["win_proxy"] = default_win_proxy(enable)
        save_accounts(data)
        ak = data.get("active", "")
        acc = (data.get("accounts") or {}).get(ak)
        if acc and acc.get("status") != "banned":
            write_tunnel_configs(acc, expose_tailscale=enable)
            subprocess.run(_py_cmd(CC_TUNNEL, "restart"), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if enable:
        print(f"✅ 已开启 Tailscale 浏览器代理监听 ({data['win_proxy']})。首次登录完成后建议运行 `cc-switch win-proxy off` 收敛暴露面。")
    else:
        print("✅ 已关闭 Tailscale 端口暴露 (仅监听本机 127.0.0.1:7890 / 7891；远程浏览器推荐使用 `ssh -N -L 7890:127.0.0.1:7890 <服务器>`)。")


def cmd_init_wizard():
    if not sys.stdin.isatty():
        print("❌ `cc-switch init` 需要交互式终端 (TTY)。非交互自动化请使用 `cc-switch add` 或 `cc-switch set-ip`。", file=sys.stderr)
        sys.exit(1)
    while True:
        data = load_accounts()
        accs = data.get("accounts", {})
        active = data.get("active", "")
        peer = get_peer_host(data)
        print("\n====================================================================================")
        print(f"🚀 cc-safe 快速配置与日常管理向导 (已录入账号: {len(accs)} | 当前激活: {active or '无'} | 拓扑: {'双机->' + peer if peer else '单机'})")
        print("====================================================================================")
        print("  [1] 🆕 添加并激活新账号       (安全隐藏输入邮箱/密码/2FA/美国家宽代理 + 5维体检)")
        print("  [2] 🔄 给已有账号换 IP        (更新静态住宅代理，无损保留设备指纹与登录态免重登！)")
        print("  [3] 🔀 切换当前激活账号       (双机进程清场 + 专线热切 + 双通道 US 核验)")
        print("  [4] 🖧  配置双机集群同步       (绑定对端服务器 IP 或切回单机模式)")
        print("  [5] 🛡️  运行 360° 防封防泄漏实测审计 (cc-audit) 与健康自检 (doctor)")
        print("  [0] 退出向导")
        choice = input("\n👉 请选择操作编号 [1/2/3/4/5/0]: ").strip()
        if choice in ("0", "q", "quit", "exit", ""):
            print("👋 已退出向导。随时可运行 `cc-safe` (或 `claude`) 进入隔离会话！")
            break
        elif choice == "1":
            try:
                cmd_add("-", None, force=False)
            except SystemExit:
                pass
        elif choice == "2":
            try:
                cmd_set_ip(None, "-", force=False)
            except SystemExit:
                pass
        elif choice == "3":
            if not accs:
                print("📭 暂无账号，请先选择 [1] 添加新账号。")
                continue
            for k, v in accs.items():
                print(f"   • {k:<10} | {v.get('email',''):<28} | IP: {v.get('ip','')} ({v.get('status','active')})")
            tk = input("👉 请输入目标账号别名: ").strip()
            if tk:
                try:
                    cmd_switch(tk, force=False)
                except SystemExit:
                    pass
        elif choice == "4":
            pip = input("👉 请输入对端主机 IP (输入 off 切回单机模式): ").strip()
            if pip:
                try:
                    cmd_set_peer(pip)
                except SystemExit:
                    pass
        elif choice == "5":
            try:
                cmd_doctor()
            except SystemExit:
                pass
            run_aud = input("是否继续运行完整 15 维真实抓包防泄漏审计 `cc-audit`? [Y/n]: ").strip().lower()
            if run_aud in ("", "y", "yes"):
                audit_bin = CC_AUDIT if os.path.exists(CC_AUDIT) else os.path.join(SELF_DIR, "cc-audit")
                subprocess.call(_py_cmd(audit_bin))
        else:
            print("⚠️ 无效选项，请输入 0~5。")


def _enforce_ban_lockdown(target_key: str):
    """将指定账号设为 banned，并在其为当前激活账号时立即清场双机进程、清空隧道配置并停用隧道（彻底阻断 cron 复活）。"""
    with global_lock(blocking=True):
        data = load_accounts()
        if target_key not in data.get("accounts", {}):
            print(f"❌ 未找到账号 '{target_key}'")
            sys.exit(1)
        data["accounts"][target_key]["status"] = "banned"
        save_accounts(data)
        is_active = data.get("active") == target_key
        peer_host = get_peer_host(data)
        if is_active:
            kill_running_cc_safe_processes(peer_host=peer_host)
            write_tunnel_configs({}, expose_tailscale=False)
            subprocess.run(_py_cmd(CC_TUNNEL, "stop"), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sync_accounts_only_to_peer(peer_host, stop_peer_tunnel=is_active, clear_peer_tunnel=is_active)


def _mark_banned_on_hold(active_key: str, raw_resp: str):
    if "account_on_hold" in (raw_resp or ""):
        _enforce_ban_lockdown(active_key)
        print(f"🚫 检测到服务端返回 account_on_hold，已自动将账号 [{active_key}] 双机标记为 banned 并锁死隧道！")


def _load_active_oauth_token(active_key: str) -> tuple:
    paths = profile_paths(active_key)
    if not os.path.exists(paths["cred"]):
        print(f"❌ 账号 [{active_key}] 尚未登录，无法查询额度。")
        sys.exit(1)
    try:
        cred = json.load(open(paths["cred"], "r", encoding="utf-8"))
    except Exception:
        cred = {}
    oauth = cred.get("claudeAiOauth") or {}
    token = str(oauth.get("accessToken") or "").strip()
    exp_ms = int(oauth.get("expiresAt", 0) or 0)
    if not token or any(c in token for c in "\r\n\x00"):
        print("❌ 未找到有效 accessToken。")
        sys.exit(1)
    if 0 < exp_ms < int(time.time() * 1000):
        print("⚠️  [提示] 本地缓存 accessToken 已过期；若报 401 请运行一次 `cc-safe` 自动刷新凭证。")
    return token, paths


def cmd_usage():
    data = load_accounts()
    active_key = data.get("active", "")
    acc = data.get("accounts", {}).get(active_key)
    if not acc:
        print("❌ 当前未激活任何有效账号。")
        sys.exit(1)

    verify_active_egress_or_die(acc)
    harvest_profile_oauth_meta(active_key, acc.get("email", ""))
    token, _ = _load_active_oauth_token(active_key)
    cver = get_claude_version()
    dyn_http, _, _, _ = get_tunnel_proxy_urls()

    out = safe_curl(
        "https://api.anthropic.com/api/oauth/usage?cedar_ember=1&at_wall=1&offerSurface=cli_menu&skip_spend=1",
        proxy_url=dyn_http,
        timeout=8,
        headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": "oauth-2025-04-20",
            "anthropic-version": "2023-06-01",
            "x-app": "cli",
            "User-Agent": f"claude-cli/{cver} (external, cli)",
        },
    )
    _mark_banned_on_hold(active_key, out)
    try:
        u = json.loads(out)
    except Exception:
        print(f"❌ 查询失败: {out[:200]}")
        sys.exit(1)

    if u.get("type") == "error" or "error" in u:
        print(f"❌ 账号 [{active_key}] 鉴权异常: {json.dumps(u, ensure_ascii=False)}")
        sys.exit(1)

    tz_cn = timezone(timedelta(hours=8))
    now_utc = datetime.now(timezone.utc)

    def fmt_reset(iso_str):
        if not iso_str:
            return "未知"
        try:
            dt = datetime.fromisoformat(str(iso_str).replace("Z", "+00:00"))
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            secs = int((dt - now_utc).total_seconds())
            rem_s = "已刷新" if secs <= 0 else f"剩余 {secs // 3600}小时 {(secs % 3600) // 60}分钟"
            return f"{dt.astimezone(tz_cn).strftime('%Y-%m-%d %H:%M:%S')} (北京时间) [{rem_s}]"
        except Exception:
            return str(iso_str)

    print("====================================================================================")
    print(f"📊 Claude 实时额度查询 — 账号: {active_key} ({acc['email']}) | 出口 IP: {acc['ip']}")
    print("====================================================================================")
    fh = u.get("five_hour") or {}
    sd = u.get("seven_day") or {}
    print(f"⏱️  5小时窗口已用 : {fh.get('utilization', 0):>5.1f}%  | 刷新: {fmt_reset(fh.get('resets_at'))}")
    sd_pct = sd.get("utilization", 0)
    print(f"📅 7天周总额已用 : {sd_pct:>5.1f}%  | 刷新: {fmt_reset(sd.get('resets_at'))}  {'🔴 已满' if sd_pct >= 100 else '🟢 正常'}")
    for lim in u.get("limits") or []:
        if lim.get("kind") == "weekly_scoped" and (lim.get("scope") or {}).get("model"):
            mname = lim["scope"]["model"].get("display_name", "Scoped")
            print(f"✨ {mname:<8} 专项周额 : {lim.get('percent', 0):>5.1f}%  | 刷新: {fmt_reset(lim.get('resets_at'))}")

    grants = ((u.get("cedar_ember") or {}).get("grants")) or []
    print("------------------------------------------------------------------------------------")
    if grants:
        print("🎟️  额度重置卡 (`cc-switch reset` 或 `/limit-reset`):")
        for g in grants:
            usable = g.get("usable_now", False)
            st_s = "🟢 立即可用 (`cc-switch reset`)" if usable else f"⏸️ 暂不可用 ({g.get('unavailable_reason')})"
            print(f"   • [{g.get('id')}] 剩余 {g.get('resets_left', 0)}/{g.get('resets_total', 0)} 张 (至 {(g.get('ends_at') or '')[:10]}) | {st_s}")
    else:
        print("🎟️  额度重置卡 : 当前账号暂无 Reset 卡")
    print("====================================================================================")


def cmd_reset():
    data = load_accounts()
    active_key = data.get("active", "")
    acc = data.get("accounts", {}).get(active_key)
    if not acc:
        print("❌ 当前未激活任何有效账号。")
        sys.exit(1)

    verify_active_egress_or_die(acc)
    id_data = harvest_profile_oauth_meta(active_key, acc.get("email", ""))
    token, _ = _load_active_oauth_token(active_key)
    org_uuid = str((id_data.get("oauthAccount") or {}).get("organizationUuid") or "").strip()
    if not org_uuid or not UUID_RE.match(org_uuid):
        print("❌ 缺少有效 organizationUuid，请先运行一次 `cc-safe` 完成初始化。")
        sys.exit(1)
    cver = get_claude_version()
    dyn_http, _, _, _ = get_tunnel_proxy_urls()

    out = safe_curl(
        "https://api.anthropic.com/api/oauth/usage?cedar_ember=1&at_wall=1&offerSurface=cli_menu&skip_spend=1",
        proxy_url=dyn_http,
        timeout=10,
        headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": "oauth-2025-04-20",
            "anthropic-version": "2023-06-01",
            "x-app": "cli",
            "User-Agent": f"claude-cli/{cver} (external, cli)",
        },
    )
    _mark_banned_on_hold(active_key, out)
    try:
        u = json.loads(out)
    except Exception:
        print(f"❌ 查询可用重置卡失败: {out[:200]}")
        sys.exit(1)

    grants = ((u.get("cedar_ember") or {}).get("grants")) or []
    usable_grant = next((g for g in grants if g.get("resets_left", 0) > 0 and g.get("usable_now")), None)
    if not usable_grant:
        reasons = [f"{g.get('id')}: left={g.get('resets_left')}, reason={g.get('unavailable_reason')}" for g in grants]
        print(f"❌ 当前账号 [{active_key}] 无立即可用的 Reset 卡 ({', '.join(reasons) or '无卡'})。")
        sys.exit(1)

    req_id = str(uuid.uuid4())
    payload = json.dumps({"program": "cedar_ember", "grant_id": usable_grant["id"], "request_id": req_id})
    print(f"🚀 正在为账号 [{active_key}] 使用重置卡 [{usable_grant['id']}]...")
    claim_out = safe_curl(
        f"https://api.anthropic.com/api/organizations/{org_uuid}/reset_rate_limits",
        proxy_url=dyn_http,
        timeout=25,
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": "oauth-2025-04-20",
            "anthropic-version": "2023-06-01",
            "x-app": "cli",
            "Content-Type": "application/json",
            "User-Agent": f"claude-cli/{cver} (external, cli)",
        },
        body=payload,
    )
    _mark_banned_on_hold(active_key, claim_out)
    try:
        res = json.loads(claim_out)
    except Exception:
        print(f"❌ 重置接口返回异常: {claim_out[:200]}")
        sys.exit(1)

    if res.get("result") == "reset":
        print(f"🎉 重置成功！已清理: {res.get('cleared')} | 剩余卡数: {res.get('resets_left')}\n")
    else:
        print(f"⚠️ 重置响应: {json.dumps(res, ensure_ascii=False)}\n")
    cmd_usage()


def cmd_import_session(query: str):
    data = load_accounts()
    active_key = data.get("active", "")
    if not active_key or active_key not in data.get("accounts", {}):
        print("❌ 当前无有效激活账号。")
        sys.exit(1)
    dst_paths = profile_paths(active_key)

    known_emails = [
        v.get("email", "").strip()
        for v in (data.get("accounts") or {}).values()
        if isinstance(v, dict) and v.get("email")
    ]

    search_roots = [os.path.join(HOME, ".claude", "projects")]
    for k in os.listdir(PROFILES_DIR):
        if k != active_key and ALIAS_RE.match(k):
            p = os.path.join(PROFILES_DIR, k, "home", "projects")
            if os.path.isdir(p):
                search_roots.append(p)

    def _file_contains_query(fpath: str, q: str) -> bool:
        if q in os.path.basename(fpath):
            return True
        try:
            with open(fpath, "r", encoding="utf-8", errors="replace") as jf:
                for line in jf:
                    if q in line:
                        return True
        except Exception:
            pass
        return False

    matches = []
    for root in search_roots:
        if not os.path.isdir(root):
            continue
        for proj_dir in glob.glob(os.path.join(root, "*")):
            if not os.path.isdir(proj_dir):
                continue
            # 1) 搜索顶层 <sid>.jsonl
            for jpath in glob.glob(os.path.join(proj_dir, "*.jsonl")):
                if _file_contains_query(jpath, query):
                    matches.append((os.path.getmtime(jpath), jpath))
                    continue
                # 2) 若关键词出现在配套 <sid>/subagents/*.jsonl 中，自动定位其父级 <sid>.jsonl
                sid_stem = os.path.basename(jpath)[:-6]
                for sub_j in glob.glob(os.path.join(proj_dir, sid_stem, "subagents", "*.jsonl")):
                    if _file_contains_query(sub_j, query):
                        matches.append((os.path.getmtime(sub_j), jpath))
                        break
            # 3) 若只有孤立的 <sid>/subagents/*.jsonl 无父级文件，也支持直接导入该子会话
            for sub_only in glob.glob(os.path.join(proj_dir, "*", "subagents", "*.jsonl")):
                sid_dir = os.path.basename(os.path.dirname(os.path.dirname(sub_only)))
                parent_j = os.path.join(proj_dir, f"{sid_dir}.jsonl")
                if not os.path.exists(parent_j) and _file_contains_query(sub_only, query):
                    matches.append((os.path.getmtime(sub_only), sub_only))

    if not matches:
        print(f"❌ 未找到匹配 '{query}' 的历史会话文件。")
        sys.exit(1)

    matches.sort(reverse=True)
    _, src_jpath = matches[0]
    old_sid = os.path.basename(src_jpath)[:-6]
    new_sid = str(uuid.uuid4())
    ns_uuid = uuid.UUID(new_sid)

    # 归入当前工作目录对应的安全 slug，避免泄漏原会话目录的宿主机用户名路径 slug
    cwd_real = os.getcwd()
    safe_proj_slug = re.sub(r"[^a-zA-Z0-9_-]", "-", cwd_real) or "imported-sessions"

    strip_types = {
        "session-owner",
        "atis-latch",
        "attribution-snapshot",
        "api-request",
        "api-request-blob",
        "api-request-shape",
        "cost-state",
        "credential_org",
    }
    strip_keys = {
        "requestId",
        "requestRef",
        "serverClassifierRequest",
        "accountUuid",
        "organizationUuid",
        "userEmail",
        "userID",
        "device_id",
        "signature",
        "gitBranch",
        "slug",
    }
    # 覆盖全部企业/学术/个人自定义域名邮箱 (负向后行断言确保 O(N) 线性时间，杜绝长文本 ReDoS 回溯)
    email_re = re.compile(r"(?<![a-zA-Z0-9_.+-])[a-zA-Z0-9_.+-]+@(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}", re.IGNORECASE)
    known_email_res = [re.compile(re.escape(em), re.IGNORECASE) for em in known_emails if em]

    def map_u(val):
        if not val or not isinstance(val, str):
            return val
        return new_sid if val == old_sid else str(uuid.uuid5(ns_uuid, val))

    def scrub_str(s: str) -> str:
        res = s.replace(old_sid, new_sid)
        if "@" in res:
            for rx in known_email_res:
                res = rx.sub("[redacted-email]", res)
            res = email_re.sub("[redacted-email]", res)
        return res

    def scrub_node(node, is_top: bool = False):
        if isinstance(node, str):
            return scrub_str(node)
        if isinstance(node, list):
            cleaned_list = []
            for item in node:
                if isinstance(item, dict) and item.get("type") in ("thinking", "redacted_thinking", "compaction"):
                    continue
                cleaned_list.append(scrub_node(item, is_top=False))
            return cleaned_list
        if isinstance(node, dict):
            out = {}
            for k, v in node.items():
                if k in strip_keys:
                    continue
                if k in ("sessionId", "session_id") and isinstance(v, str):
                    out[k] = new_sid
                elif k in ("uuid", "parentUuid", "leafUuid", "sourceToolAssistantUUID") and isinstance(v, str):
                    out[k] = map_u(v)
                elif k == "cwd" and isinstance(v, str):
                    out[k] = cwd_real
                elif k == "id" and isinstance(v, str) and v.startswith(("msg_", "srvtoolu_")):
                    prefix = "msg_01" if v.startswith("msg_") else "srvtoolu_01"
                    out[k] = prefix + secrets.token_hex(11)
                else:
                    out[k] = scrub_node(v, is_top=False)
            if isinstance(out.get("content"), list) and not out["content"] and node.get("role") == "assistant":
                out["content"] = [{"type": "text", "text": "(sanitized)"}]
            return out
        return node

    def sanitize_jsonl_file(in_path: str, out_path: str):
        lines_out = []
        with open(in_path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                s = line.strip()
                if not s:
                    continue
                try:
                    obj = json.loads(s)
                except Exception:
                    continue
                if not isinstance(obj, dict) or obj.get("type") in strip_types:
                    continue
                cleaned_obj = scrub_node(obj, is_top=True)
                lines_out.append(json.dumps(cleaned_obj, ensure_ascii=False) + "\n")
        atomic_write_text(out_path, "".join(lines_out), 0o600)

    dst_proj_dir = os.path.join(dst_paths["projects"], safe_proj_slug)
    ensure_dir_700(dst_proj_dir)
    dst_file = os.path.join(dst_proj_dir, f"{new_sid}.jsonl")
    sanitize_jsonl_file(src_jpath, dst_file)

    # 同步深度脱敏并迁移关联的 <old_sid>/subagents/*.jsonl
    src_sub_dir = os.path.join(os.path.dirname(src_jpath), old_sid, "subagents")
    sub_count = 0
    if os.path.isdir(src_sub_dir):
        dst_sub_dir = os.path.join(dst_proj_dir, new_sid, "subagents")
        ensure_dir_700(os.path.join(dst_proj_dir, new_sid))
        ensure_dir_700(dst_sub_dir)
        for sub_src in sorted(glob.glob(os.path.join(src_sub_dir, "*.jsonl"))):
            sub_name = os.path.basename(sub_src).replace(old_sid, new_sid)
            sanitize_jsonl_file(sub_src, os.path.join(dst_sub_dir, sub_name))
            sub_count += 1

    print(f"✅ 已深度脱敏并导入会话至当前账号 [{active_key}]:")
    print(f"   源文件 : {src_jpath}" + (f" (连同 {sub_count} 个 subagent 子会话)" if sub_count else ""))
    print(f"   新文件 : {dst_file} (全新 sessionId={new_sid}，已剥离全域名邮箱/UUID/cwd/签名)")


def cmd_set_peer(peer_ip: str):
    peer_ip = (peer_ip or "").strip()
    with global_lock(blocking=True):
        data = load_accounts()
        if peer_ip.lower() in ("none", "off", "clear", ""):
            data["peers"] = {}
            data["nodes"] = {}
            save_accounts(data)
            print("✅ 已切换为单机运行模式 (已清空 peers/nodes)。")
            return
        try:
            clean_peer = validate_peer_host(peer_ip)
        except ValueError as e:
            print(f"❌ {e}", file=sys.stderr)
            sys.exit(1)
        data.setdefault("peers", {})[HOSTNAME] = clean_peer
        # 清空可能覆盖 set-peer 的旧版 nodes 字段，确保 get_peer_host 100% 一致
        data["nodes"] = {}
        save_accounts(data)
        print(f"✅ 已绑定本机 ({HOSTNAME}) 对端主机为: {clean_peer}")


def cmd_doctor():
    print("====================================================================================")
    print(f"🩺 cc-safe 全维度防封隔离健康自检 — 主机: {HOSTNAME}")
    print("====================================================================================")
    issues = 0
    data = load_accounts()
    active_key = data.get("active", "")
    acc = data.get("accounts", {}).get(active_key, {})

    # 1. ~/.claude 中转隔离检查 (同时检查 ~/.claude.json 与 ~/.claude/.claude.json 及 .credentials.json)
    sub_cred = os.path.join(HOME, ".claude", ".credentials.json")
    sub_oa = None
    for cj_cand in (os.path.join(HOME, ".claude.json"), os.path.join(HOME, ".claude", ".claude.json")):
        if os.path.exists(cj_cand):
            try:
                oa_val = json.load(open(cj_cand, "r", encoding="utf-8")).get("oauthAccount")
                if oa_val:
                    sub_oa = oa_val
                    break
            except Exception:
                pass
    if os.path.exists(sub_cred) or sub_oa:
        print("❌ [1/8] ~/.claude 隔离异常: 检测到残留个人 OAuth 凭证或 oauthAccount！")
        issues += 1
    else:
        print("✅ [1/8] ~/.claude 与 ~/.claude-safe 物理隔离完好 (零个人 OAuth 凭证残留)")

    # 2. ~/.claude-safe 权限与软链接检查
    bad_links = []
    safe_mode = 0o700 if IS_WINDOWS else (os.stat(SAFE_DIR).st_mode & 0o777 if os.path.exists(SAFE_DIR) else 0o700)
    for root, dirs, files in os.walk(SAFE_DIR):
        for name in dirs + files:
            full = os.path.join(root, name)
            if os.path.islink(full):
                bad_links.append(f"{full} -> {os.readlink(full)}")
    if bad_links or safe_mode != 0o700:
        print(f"❌ [2/8] 目录安全异常: 权限={oct(safe_mode)} (要求 0o700), 软链接={bad_links}")
        issues += 1
    else:
        perm_lbl = "NTFS 用户独占隔离" if IS_WINDOWS else "权限严格 0700"
        print(f"✅ [2/8] ~/.claude-safe {perm_lbl} 且零跨目录软链接")

    # 3. 各账号指纹与 IP 互斥性校验
    seen_uids, seen_mids, seen_ips = {}, {}, {}
    fp_clash = False
    for k, av in data.get("accounts", {}).items():
        if not ALIAS_RE.match(k) or not isinstance(av, dict):
            continue
        idd = ensure_profile_identity(k)
        uid, mid = idd["userID"], idd["machineID"]
        aip = str(av.get("ip") or "").strip()
        if uid in seen_uids or mid in seen_mids:
            print(f"❌ [3/8] 指纹撞车: 账号 [{k}] 与已有账号共享 userID 或 machineID！")
            fp_clash = True
            issues += 1
        if aip and aip in seen_ips:
            print(f"❌ [3/8] IP 撞车: 账号 [{k}] 与账号 [{seen_ips[aip]}] 绑定了相同出口 IP ({aip})！")
            fp_clash = True
            issues += 1
        seen_uids[uid] = k
        seen_mids[mid] = k
        if aip:
            seen_ips[aip] = k
    if not fp_clash:
        print(f"✅ [3/8] 全部 {len(seen_uids)} 个账号设备指纹 (userID / machineID) 与出口 IP 100% 互异")

    # 4. 当前激活账号状态
    if not active_key or not acc:
        print("❌ [4/8] 当前无有效激活账号 (请运行 `cc-switch init` 或 `cc-switch add -` 添加)")
        issues += 1
    elif acc.get("status") == "banned":
        print(f"❌ [4/8] 当前激活账号 [{active_key}] 处于 banned 状态，请切换到可用账号！")
        issues += 1
    else:
        print(f"✅ [4/8] 当前激活账号 [{active_key}] 状态正常 (绑定 IP: {acc.get('ip')})")

    # 5. 双通道隧道出口 (HTTP + SOCKS5h 均需 IP 匹配且 loc == US) 与 Gost cmdline 零泄密校验
    exp_ip = str(acc.get("ip") or "").strip()
    dyn_http, dyn_socks, cur_http_l, cur_socks_l = get_tunnel_proxy_urls()
    t_http = probe_tunnel_trace(dyn_http, timeout=6) if exp_ip else {}
    t_socks = probe_tunnel_trace(dyn_socks, timeout=6) if exp_ip else {}
    cmdline_leak = False
    if not IS_WINDOWS:
        for pdir in glob.glob("/proc/[0-9]*"):
            base = os.path.basename(pdir)
            if not base.isdigit():
                continue
            try:
                if os.stat(pdir).st_uid != os.getuid():
                    continue
                cmd = open(f"{pdir}/cmdline", "rb").read().decode("utf-8", "ignore")
                if "gost" in cmd and ("-F\x00" in cmd or "@" in cmd):
                    cmdline_leak = True
            except Exception:
                pass

    if cmdline_leak:
        print("❌ [5/8] 检测到旧版 gost 进程在命令行暴露代理账密，请运行 `cc-us-tunnel restart`！")
        issues += 1
    elif (
        exp_ip
        and t_http.get("ip") == exp_ip
        and t_socks.get("ip") == exp_ip
        and t_http.get("loc") == "US"
        and t_socks.get("loc") == "US"
    ):
        print(f"✅ [5/8] 本机 HTTP({cur_http_l}) & SOCKS5h({cur_socks_l}) 双通道 US 一致: {exp_ip} ({t_http.get('colo')}, 进程零明文凭据)")
    else:
        print(
            f"❌ [5/8] 本机隧道出口不匹配: HTTP={t_http.get('ip')}({t_http.get('loc')}), "
            f"SOCKS5h={t_socks.get('ip')}({t_socks.get('loc')}), 预期={exp_ip or '未设置'}"
        )
        issues += 1

    # 6. 平台网络劫持/熔断组件检查
    if IS_WINDOWS:
        win_l = os.path.join(SAFE_DIR, "libexec", "py", "cc_win_launcher.py")
        gost_w = os.path.join(BIN_DIR, "gost.exe")
        if os.path.isfile(win_l) and (os.path.isfile(gost_w) or shutil.which("gost.exe")):
            print("✅ [6/8] Windows NT Job Object + 实时断流熔断看门狗 (cc_win_launcher) 与 gost.exe 已就绪")
        else:
            print("❌ [6/8] 缺少 cc_win_launcher.py 或 gost.exe，请重跑 .\\install.ps1 修复！")
            issues += 1
    else:
        pc_path = os.path.join(HOME, ".local", "etc", "proxychains.conf")
        pc_txt = open(pc_path, "r", encoding="utf-8").read() if os.path.exists(pc_path) else ""
        if "strict_chain" in pc_txt and "proxy_dns" in pc_txt and "127.0.0.1 7891" in pc_txt:
            print("✅ [6/8] proxychains.conf 配置合规 (strict_chain + proxy_dns + 127.0.0.1:7891)")
        else:
            print("❌ [6/8] proxychains.conf 缺少 strict_chain 或 proxy_dns！")
            issues += 1

    # 7. 进程串号与孤儿残留检查
    rogue_procs = find_cc_safe_processes(only_rogue_for_account=active_key or "__none__")
    if rogue_procs:
        rogue_desc = [f"{p['pid']}({p['comm']})" for p in rogue_procs]
        print(f"❌ [7/8] 发现未绑定当前激活账号的残留/野生订阅进程: {rogue_desc} (可运行 `cc-switch kill` 清理)")
        issues += 1
    else:
        print("✅ [7/8] 本机无串号、孤儿子进程或裸奔的野生订阅 claude 进程")

    # 8. 对端主机一致性与残留进程检查
    topo_warn = check_topology_warning(data)
    peer_host = get_peer_host(data)
    if topo_warn:
        print(f"❌ [8/8] {topo_warn}")
        issues += 1
    elif not peer_host:
        print("✅ [8/8] 单机运行模式 (未配置对端节点)")
    else:
        peer_chk = """
python3 - <<'PY'
import importlib.machinery, importlib.util, json, os, subprocess
h = os.path.expanduser("~")
sub_c = os.path.exists(h + "/.claude/.credentials.json")
for cj in (h + "/.claude.json", h + "/.claude/.claude.json"):
    if os.path.exists(cj):
        try:
            if json.load(open(cj)).get("oauthAccount"):
                sub_c = True
        except Exception:
            pass
af = h + "/.claude-safe/config/accounts.json"
ak = json.load(open(af)).get("active", "NONE") if os.path.exists(af) else "NONE"
def _tr(px):
    out = subprocess.run(["curl","-s","--noproxy","","-x",px,"--max-time","5","https://api.anthropic.com/cdn-cgi/trace"], capture_output=True, text=True).stdout
    m = dict(l.strip().split("=",1) for l in out.splitlines() if "=" in l)
    return m.get("ip","FAIL"), m.get("loc","FAIL")
hip, hloc = _tr("http://127.0.0.1:7890")
sip, sloc = _tr("socks5h://127.0.0.1:7891")
rogue_cnt = 0
sw = h + "/.local/bin/cc-switch"
if os.path.exists(sw):
    loader = importlib.machinery.SourceFileLoader("cc_switch_mod", sw)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    rogue_cnt = len(mod.find_cc_safe_processes(only_rogue_for_account=ak if ak != "NONE" else "__none__"))
print(f"{ak}|{hip}|{hloc}|{sip}|{sloc}|{sub_c}|{rogue_cnt}")
PY
"""
        try:
            r = subprocess.run(
                ["ssh", *SSH_BASE_OPTS, "--", peer_host, peer_chk],
                capture_output=True,
                text=True,
                timeout=12,
            )
            parts = (r.stdout.strip().splitlines()[-1].split("|") + [""] * 7)[:7] if r.stdout.strip() else [""] * 7
            p_ak, p_hip, p_hloc, p_sip, p_sloc, p_sub, p_rogue = parts
            if (
                p_ak == active_key
                and p_hip == exp_ip
                and p_sip == exp_ip
                and p_hloc == "US"
                and p_sloc == "US"
                and p_sub == "False"
                and p_rogue == "0"
            ):
                print(f"✅ [8/8] 对端 ({peer_host}) 完全同步一致: active={p_ak}, HTTP & SOCKS5h={p_hip}(US), ~/.claude 零泄漏, 零异常进程")
            else:
                print(
                    f"❌ [8/8] 对端 ({peer_host}) 状态不一致: active={p_ak}, HTTP={p_hip}({p_hloc}), "
                    f"SOCKS5h={p_sip}({p_sloc}), sub_cred_leak={p_sub}, rogue_procs={p_rogue}"
                )
                issues += 1
        except Exception as e:
            print(f"❌ [8/8] 对端 ({peer_host}) SSH 检查失败: {e}")
            issues += 1

    print("====================================================================================")
    if issues == 0:
        print("🟢 [自检通过] 全部 8 项防封隔离指标 100% 绿灯合规！")
    else:
        print(f"🔴 [发现隐患] 共检测到 {issues} 项问题，请按上述提示修复！")
        sys.exit(1)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("status", "list", "ls"):
        cmd_status()
    elif args[0] in ("-h", "--help", "help"):
        print_help()
    elif args[0] in ("-v", "--version", "version"):
        print("cc-switch (cc-safe) v2.0.0")
    elif args[0] in ("init", "quickstart", "wizard"):
        cmd_init_wizard()
    elif args[0] in ("usage", "quota"):
        cmd_usage()
    elif args[0] in ("reset", "limit-reset"):
        cmd_reset()
    elif args[0] == "doctor":
        cmd_doctor()
    elif args[0] in ("audit", "test-leak"):
        audit_bin = CC_AUDIT if os.path.exists(CC_AUDIT) else os.path.join(SELF_DIR, "cc-audit")
        sys.exit(subprocess.call(_py_cmd(audit_bin, *args[1:])))
    elif args[0] in ("kill", "clean-procs"):
        cmd_kill()
    elif args[0] == "kill-local":
        ex_acc = None
        if "--exclude" in args:
            idx = args.index("--exclude")
            if idx + 1 < len(args):
                ex_acc = args[idx + 1]
        print(json.dumps(kill_local_cc_safe_tree(exclude_account=ex_acc), ensure_ascii=False))
    elif args[0] == "totp":
        data = load_accounts()
        ak = args[1] if len(args) >= 2 and not args[1].startswith("-") else data.get("active", "")
        acc = data.get("accounts", {}).get(ak)
        if not acc:
            print(f"❌ 未找到账号 '{ak}'", file=sys.stderr)
            sys.exit(1)
        code, rem = gen_totp(acc.get("totp", ""))
        if "--raw" in args:
            print(code)
        else:
            print(f"{code}  (账号: {ak}, 剩余 {rem}s)")
    elif args[0] == "pass":
        data = load_accounts()
        ak = args[1] if len(args) >= 2 else data.get("active", "")
        if ak in data.get("accounts", {}):
            print(data["accounts"][ak]["pass"])
        else:
            print(f"❌ 未找到账号 '{ak}'", file=sys.stderr)
            sys.exit(1)
    elif args[0] == "check-ip":
        data = load_accounts()
        accounts = data.get("accounts", {})
        if len(args) < 2:
            ak = data.get("active", "")
            proxy = accounts.get(ak, {}).get("proxy", PROXY_HTTP)
            chk_env = dict(os.environ, CC_CHECK_PROXY_URL=proxy)
            sys.exit(subprocess.call(_py_cmd(CC_CHECK_IP), env=chk_env))
        target = args[1].strip()
        email_match = next(
            (k for k, v in accounts.items() if isinstance(v, dict) and str(v.get("email") or "").strip().lower() == target.lower()),
            None,
        )
        if target == "-":
            sys.exit(subprocess.call(_py_cmd(CC_CHECK_IP, "-")))
        elif target in accounts:
            chk_env = dict(os.environ, CC_CHECK_PROXY_URL=accounts[target]["proxy"])
            sys.exit(subprocess.call(_py_cmd(CC_CHECK_IP), env=chk_env))
        elif email_match:
            chk_env = dict(os.environ, CC_CHECK_PROXY_URL=accounts[email_match]["proxy"])
            sys.exit(subprocess.call(_py_cmd(CC_CHECK_IP), env=chk_env))
        elif "://" in target or ":" in target:
            proxy_url, _ = _parse_proxy_input(target)
            chk_env = dict(os.environ, CC_CHECK_PROXY_URL=proxy_url)
            sys.exit(subprocess.call(_py_cmd(CC_CHECK_IP), env=chk_env))
        else:
            print(f"❌ 未找到账号 '{target}'，也不是合法的代理地址格式！", file=sys.stderr)
            sys.exit(1)
    elif args[0] in ("set-ip", "change-ip", "rotate-ip", "update-ip", "set-proxy", "update-proxy", "huan-ip"):
        clean_args = [a for a in args[1:] if a != "--force"]
        t_acc = clean_args[0] if len(clean_args) >= 1 else None
        p_raw = clean_args[1] if len(clean_args) >= 2 else None
        cmd_set_ip(t_acc, p_raw, force=("--force" in args))
    elif args[0] in ("rm", "remove", "del", "delete"):
        clean_args = [a for a in args[1:] if a != "--purge"]
        if not clean_args:
            print("用法: cc-switch rm <账号别名> [--purge]")
            sys.exit(1)
        cmd_remove(clean_args[0], purge_files=("--purge" in args))
    elif args[0] == "win-proxy":
        if len(args) < 2:
            print("用法: cc-switch win-proxy <on | off>")
            sys.exit(1)
        cmd_win_proxy(args[1])
    elif args[0] == "ban":
        if len(args) < 2:
            print("用法: cc-switch ban <账号别名>")
            sys.exit(1)
        ak = validate_alias_or_die(args[1])
        _enforce_ban_lockdown(ak)
        print(f"✅ 已将账号 [{ak}] 标记为 banned 并双机同步锁死隧道 (防 cron 复活)。")
    elif args[0] == "unban":
        if len(args) < 2:
            print("用法: cc-switch unban <账号别名>")
            sys.exit(1)
        ak = validate_alias_or_die(args[1])
        with global_lock(blocking=True):
            data = load_accounts()
            if ak not in data.get("accounts", {}):
                print(f"❌ 未找到账号 '{ak}'")
                sys.exit(1)
            data["accounts"][ak]["status"] = "active"
            save_accounts(data)
            sync_accounts_only_to_peer(get_peer_host(data), stop_peer_tunnel=False)
        print(f"✅ 已解除账号 [{ak}] 的 banned 状态（如需启用请运行 `cc-switch {ak}`）。")
    elif args[0] == "set-peer":
        if len(args) < 2:
            print("用法: cc-switch set-peer <对端IP | off>")
            sys.exit(1)
        cmd_set_peer(args[1])
    elif args[0] == "import-session":
        if len(args) < 2:
            print("用法: cc-switch import-session <标题关键词或UUID>")
            sys.exit(1)
        cmd_import_session(args[1])
    elif args[0] == "apply-local":
        clean_args = [a for a in args[1:] if a not in ("--if-idle", "--unlocked")]
        if "--unlocked" in args:
            ak = clean_args[0] if clean_args else load_accounts().get("active", "")
            if ak and ALIAS_RE.match(ak):
                apply_profile_locally(ak, if_idle=("--if-idle" in args))
        else:
            with global_lock(blocking=True):
                ak = clean_args[0] if clean_args else load_accounts().get("active", "")
                if ak and ALIAS_RE.match(ak):
                    apply_profile_locally(ak, if_idle=("--if-idle" in args))
    elif args[0] == "auto-sync":
        cmd_auto_sync()
    elif args[0] == "sync-cred":
        clean_args = [a for a in args[1:] if a != "--quiet"]
        target_a = clean_args[0] if clean_args else None
        cmd_sync(target_acc=target_a, quiet=("--quiet" in args), cred_only=True)
    elif args[0] == "sync":
        clean_args = [a for a in args[1:] if a != "--quiet"]
        target_a = clean_args[0] if clean_args else None
        cmd_sync(target_acc=target_a, quiet=("--quiet" in args), cred_only=False)
    elif args[0] in ("desktop", "chrome"):
        if not IS_WINDOWS:
            print(f"⚠️  `{args[0]}` 为 Windows 原生图形客户端隔离启动命令；请在 Windows 上运行 `cc-{args[0]}`。", file=sys.stderr)
            sys.exit(1)
        win_launcher = os.path.join(SAFE_DIR, "libexec", "py", "cc_win_launcher.py")
        if not os.path.isfile(win_launcher):
            win_launcher = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "windows", "cc_win_launcher.py")
        sys.exit(subprocess.call([sys.executable, win_launcher, args[0], *args[1:]]))
    elif args[0] == "add":
        clean_args = [a for a in args[1:] if a != "--force"]
        if not clean_args:
            if sys.stdin.isatty():
                cmd_add("-", None, force=("--force" in args))
            else:
                print("用法: cc-switch add - [别名]  或  cc-switch add '<邮箱----密码----TOTP----sid----代理>' [别名] [--force]")
                sys.exit(1)
        else:
            cmd_add(clean_args[0], clean_args[1] if len(clean_args) >= 2 else None, force=("--force" in args))
    else:
        if args[0].startswith("-"):
            print(f"❌ 未知选项 '{args[0]}'。请运行 `cc-switch --help` 查看帮助。", file=sys.stderr)
            sys.exit(1)
        cmd_switch(args[0], force=("--force" in args))


if __name__ == "__main__":
    main()
